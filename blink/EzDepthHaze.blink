// EzDepthHaze: hazes a plate with its depth, lit like EzAtmosScatter's haze.
//
// For every pixel the kernel finds the view direction (from the camera, or from the
// lat-long position), converts its depth to metres, and works out how much haze lies
// between the camera and the surface. The haze thins exponentially with altitude, so
// looking up clears faster than looking sideways:
//
//   tau    = density * H / c * (exp(-c * s / H) - exp(-c * d / H)),  c = dir.y
//   T      = exp(-tau)
//   result = plate * T + hazeColor(dir) * (1 - T)
//
// where s is where the haze starts along the ray, d the surface distance and H the haze
// height. hazeColor is the colour infinitely deep haze has in that direction: the `env`
// input (EzAtmosScatter's atmos_haze_color lat-long) or a flat colour.
//
// With `volumetric` on, the ray is marched instead so the density can vary along it: the
// same haze, plus a fog layer that fills everything below fogTop and fades out over
// fogSoftness above it, all modulated by 3D fBm noise fixed in world space (it drifts
// with noiseWind over noiseTime, so it stays put when the camera moves).
//
// Inputs: `plate` rgba, `depth` with the depth in red, `env` a lat-long in the
// EzAtmosScatter convention (centre column looks down -Z, top row up).
// Distances are in metres, +Y is up.
//
// output: 0 = hazed plate, 1 = haze transmittance, 2 = haze in-scatter

kernel EzDepthHaze : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> plate;
  Image<eRead, eAccessPoint, eEdgeClamped> depth;
  Image<eRead, eAccessRandom, eEdgeClamped> env;
  Image<eWrite> dst;

param:
  int output;
  int latlongPlate;
  float3 camRow0;
  float3 camRow1;
  float3 camRow2;
  float3 camPosition;
  float focal;
  float haperture;
  float vaperture;
  float latlongCameraHeight;
  int depthType;
  float depthScale;
  float skyThreshold;
  int hazeSky;
  float skyDistance;
  int useEnv;
  float envRotation;
  float3 hazeColor;
  float hazeColorGain;
  float3 hazeDensity;
  float hazeAmount;
  float hazeHeight;
  float hazeStart;
  float maxDistance;
  int volumetric;
  int marchSteps;
  float fogDensity;
  float fogTop;
  float fogSoftness;
  float noiseAmount;
  float noiseOnHaze;
  float noiseSize;
  float noiseStretch;
  int noiseDetail;
  float3 noiseWind;
  float noiseTime;
  float noiseSeed;

local:
  float pi;

  void define()
  {
    defineParam(output, "output", 0);
    defineParam(latlongPlate, "latlong_plate", 0);
    defineParam(camRow0, "cam_row0", float3(1.0f, 0.0f, 0.0f));
    defineParam(camRow1, "cam_row1", float3(0.0f, 1.0f, 0.0f));
    defineParam(camRow2, "cam_row2", float3(0.0f, 0.0f, 1.0f));
    defineParam(camPosition, "cam_position", float3(0.0f, 0.0f, 0.0f));
    defineParam(focal, "focal", 35.0f);
    defineParam(haperture, "haperture", 36.0f);
    defineParam(vaperture, "vaperture", 20.25f);
    defineParam(latlongCameraHeight, "latlong_camera_height", 1.0f);
    defineParam(depthType, "depth_type", 0);
    defineParam(depthScale, "depth_scale", 1.0f);
    defineParam(skyThreshold, "sky_threshold", 1e7f);
    defineParam(hazeSky, "haze_sky", 0);
    defineParam(skyDistance, "sky_distance", 50000.0f);
    defineParam(useEnv, "use_env", 1);
    defineParam(envRotation, "env_rotation", 0.0f);
    defineParam(hazeColor, "haze_color", float3(0.6f, 0.65f, 0.75f));
    defineParam(hazeColorGain, "haze_color_gain", 1.0f);
    defineParam(hazeDensity, "haze_density", float3(0.0001f, 0.0001f, 0.0001f));
    defineParam(hazeAmount, "haze_amount", 1.0f);
    defineParam(hazeHeight, "haze_height", 1200.0f);
    defineParam(hazeStart, "haze_start", 0.0f);
    defineParam(maxDistance, "max_distance", 0.0f);
    defineParam(volumetric, "volumetric", 0);
    defineParam(marchSteps, "march_steps", 48);
    defineParam(fogDensity, "fog_density", 0.0f);
    defineParam(fogTop, "fog_top", 1000.0f);
    defineParam(fogSoftness, "fog_softness", 300.0f);
    defineParam(noiseAmount, "noise_amount", 0.0f);
    defineParam(noiseOnHaze, "noise_on_haze", 0.3f);
    defineParam(noiseSize, "noise_size", 2000.0f);
    defineParam(noiseStretch, "noise_stretch", 3.0f);
    defineParam(noiseDetail, "noise_detail", 4);
    defineParam(noiseWind, "noise_wind", float3(5.0f, 0.0f, 0.0f));
    defineParam(noiseTime, "noise_time", 0.0f);
    defineParam(noiseSeed, "noise_seed", 1.0f);
  }

  void init()
  {
    pi = 3.14159265358979f;
  }

  float3 exp3(float3 v)
  {
    return float3(exp(v.x), exp(v.y), exp(v.z));
  }

  float3 envLookup(float3 d)
  {
    float lon = atan2(d.x, -d.z) - envRotation * pi / 180.0f;
    float lat = asin(clamp(d.y, -1.0f, 1.0f));
    float u = lon / (2.0f * pi) + 0.5f;
    u = u - floor(u);
    float v = lat / pi + 0.5f;
    float x = env.bounds.x1 + u * env.bounds.width() - 0.5f;
    float y = env.bounds.y1 + v * env.bounds.height() - 0.5f;
    float4 c = bilinear(env, x, y);
    return float3(c.x, c.y, c.z);
  }

  float hash3(float3 p)
  {
    float h = sin(p.x * 127.1f + p.y * 311.7f + p.z * 74.7f + noiseSeed * 19.3f) * 43758.5453f;
    return h - floor(h);
  }

  float vnoise3(float3 p)
  {
    float ix = floor(p.x), iy = floor(p.y), iz = floor(p.z);
    float fx = p.x - ix, fy = p.y - iy, fz = p.z - iz;
    float ux = fx * fx * (3.0f - 2.0f * fx);
    float uy = fy * fy * (3.0f - 2.0f * fy);
    float uz = fz * fz * (3.0f - 2.0f * fz);
    float a = hash3(float3(ix, iy, iz)), b = hash3(float3(ix + 1.0f, iy, iz));
    float c = hash3(float3(ix, iy + 1.0f, iz)), d = hash3(float3(ix + 1.0f, iy + 1.0f, iz));
    float e = hash3(float3(ix, iy, iz + 1.0f)), f = hash3(float3(ix + 1.0f, iy, iz + 1.0f));
    float g = hash3(float3(ix, iy + 1.0f, iz + 1.0f)), h = hash3(float3(ix + 1.0f, iy + 1.0f, iz + 1.0f));
    float ab = a + (b - a) * ux, cd = c + (d - c) * ux;
    float ef = e + (f - e) * ux, gh = g + (h - g) * ux;
    float lo = ab + (cd - ab) * uy, hi = ef + (gh - ef) * uy;
    return lo + (hi - lo) * uz;
  }

  // Density multiplier from world-space fBm: 1 on average, more or less where the noise
  // is high or low. Squashed vertically so it reads as banks and wisps, not blobs.
  float noiseFactor(float3 p)
  {
    if (noiseAmount <= 0.0f)
      return 1.0f;
    float3 q = (p - noiseWind * noiseTime) / noiseSize;
    q.y *= noiseStretch;
    float sum = 0.0f, amp = 0.5f, norm = 0.0f;
    for (int i = 0; i < noiseDetail; i++) {
      sum += amp * vnoise3(q);
      norm += amp;
      q = float3(q.x * 2.03f + 1.7f, q.y * 2.03f + 9.2f, q.z * 2.03f + 4.1f);
      amp *= 0.5f;
    }
    float n = sum / norm;
    return max(1.0f + noiseAmount * 2.5f * (n - 0.5f), 0.0f);
  }

  // Extinction per metre at p: the base haze, thinning with height from the camera, plus
  // the fog layer, which is full below fogTop and fades out over fogSoftness above it.
  float3 density(float3 p, float cameraHeight)
  {
    float3 haze = hazeDensity * (hazeAmount * exp(-(p.y - cameraHeight) / hazeHeight));
    float edge = clamp((p.y - fogTop) / max(fogSoftness, 1.0f) + 0.5f, 0.0f, 1.0f);
    float fog = fogDensity * (1.0f - edge * edge * (3.0f - 2.0f * edge));
    float n = noiseFactor(p);
    return (haze * (1.0f - noiseOnHaze + noiseOnHaze * n)) + float3(fog * n);
  }

  // Integral of exp(-c * t / H) for t from s to d: the optical length of the ray
  // through haze that thins with height.
  float heightPath(float c, float s, float d)
  {
    if (fabs(c) * (d - s) / hazeHeight < 1e-4f)
      return (d - s) * exp(-c * s / hazeHeight);
    return hazeHeight / c * (exp(-c * s / hazeHeight) - exp(-c * d / hazeHeight));
  }

  void process(int2 pos)
  {
    float4 src = plate();
    float rawDepth = depth().x;

    float u = (pos.x - plate.bounds.x1 + 0.5f) / plate.bounds.width();
    float v = (pos.y - plate.bounds.y1 + 0.5f) / plate.bounds.height();
    float3 dir;
    float3 origin;
    float planarScale = 1.0f;
    if (latlongPlate != 0) {
      float lon = (u - 0.5f) * 2.0f * pi;
      float lat = (v - 0.5f) * pi;
      dir = float3(sin(lon) * cos(lat), sin(lat), -cos(lon) * cos(lat));
      origin = float3(0.0f, latlongCameraHeight, 0.0f);
    } else {
      float3 camDir = float3((u - 0.5f) * haperture / focal, (v - 0.5f) * vaperture / focal, -1.0f);
      planarScale = length(camDir);
      dir = normalize(float3(dot(camRow0, camDir), dot(camRow1, camDir), dot(camRow2, camDir)));
      origin = camPosition;
    }

    // Depth to distance along the ray, in metres.
    float dist = rawDepth;
    if (depthType == 1)
      dist = rawDepth * planarScale;
    else if (depthType == 2)
      dist = rawDepth > 0.0f ? planarScale / rawDepth : 0.0f;
    dist *= depthScale;

    bool sky = rawDepth <= 0.0f || dist >= skyThreshold;
    if (sky)
      dist = hazeSky != 0 ? skyDistance : 0.0f;
    if (maxDistance > 0.0f)
      dist = min(dist, maxDistance);

    float s = min(hazeStart, dist);
    float3 light = useEnv != 0 ? envLookup(dir) : hazeColor;
    light *= hazeColorGain;

    float3 transmittance;
    float3 inscatter;
    if (volumetric == 0) {
      // Density is given at camera height; heightPath measures from the camera.
      float path = heightPath(dir.y, s, dist);
      transmittance = exp3(-hazeDensity * (hazeAmount * path));
      inscatter = light * (float3(1.0f) - transmittance);
    } else {
      // March the ray, so the density can change along it: haze thinning with height,
      // a fog layer below fogTop, and world-space noise. Steps are packed towards the
      // camera (quadratic spacing) and jittered per pixel to hide banding.
      float jitter = hash3(float3(pos.x, pos.y, 17.0f));
      transmittance = float3(1.0f);
      inscatter = float3(0.0f);
      float tPrev = s;
      for (int i = 0; i < marchSteps; i++) {
        float f = (i + jitter) / marchSteps;
        float t = s + (dist - s) * f * f;
        float dt = t - tPrev;
        tPrev = t;
        float3 p = origin + dir * t;
        float3 sigma = density(p, origin.y) * dt;
        float3 stepT = exp3(-sigma);
        inscatter += transmittance * (float3(1.0f) - stepT) * light;
        transmittance *= stepT;
      }
      // Last stretch up to the surface.
      float3 p = origin + dir * (0.5f * (tPrev + dist));
      float3 stepT = exp3(-density(p, origin.y) * (dist - tPrev));
      inscatter += transmittance * (float3(1.0f) - stepT) * light;
      transmittance *= stepT;
    }

    float3 rgb = float3(src.x, src.y, src.z) * transmittance + inscatter;
    float alpha = src.w;
    if (output == 1) {
      rgb = transmittance;
      alpha = 1.0f;
    } else if (output == 2) {
      rgb = inscatter;
      alpha = 1.0f;
    }
    dst() = float4(rgb.x, rgb.y, rgb.z, alpha);
  }
};
