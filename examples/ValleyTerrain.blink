// ValleyTerrain: like DemoTerrain, but a deep glacial valley (granite walls, a forested floor,
// uplands beyond the rim) seen from the rim, for trying
// EzDepthHaze without a CG render. Writes the lit terrain in rgb and the distance from
// the camera in metres in alpha (0 where the ray reaches the sky).
//
// Camera: pass the Camera node's world matrix rows (rotation part) and position, plus
// focal length and film back, exactly as the gizmo's knobs expect. Distances and heights
// are in metres, +Y is up. The `sky` input is a lat-long (same convention as
// EzAtmosScatter) used for the sky pixels and the ambient light.

kernel ValleyTerrain : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> ref;
  Image<eRead, eAccessRandom, eEdgeClamped> sky;
  Image<eWrite> dst;

param:
  float3 camRow0;
  float3 camRow1;
  float3 camRow2;
  float3 camPosition;
  float focal;
  float haperture;
  float vaperture;
  float3 sunDirection;
  float3 sunColor;
  float sunIntensity;
  float sunDiscRadiance;
  float ambientStrength;
  float terrainHeight;
  float terrainScale;
  float seed;
  float seaLevel;
  float valleyDirection;
  float floorWidth;
  float wallWidth;
  float rimHeight;
  float meander;

local:
  float pi;
  float3 sunDir;

  void define()
  {
    defineParam(camRow0, "cam_row0", float3(1.0f, 0.0f, 0.0f));
    defineParam(camRow1, "cam_row1", float3(0.0f, 1.0f, 0.0f));
    defineParam(camRow2, "cam_row2", float3(0.0f, 0.0f, 1.0f));
    defineParam(camPosition, "cam_position", float3(0.0f, 2400.0f, 0.0f));
    defineParam(focal, "focal", 35.0f);
    defineParam(haperture, "haperture", 36.0f);
    defineParam(vaperture, "vaperture", 20.25f);
    defineParam(sunDirection, "sun_direction", float3(-0.2f, 0.08f, -1.0f));
    defineParam(sunColor, "sun_color", float3(1.0f, 0.55f, 0.25f));
    defineParam(sunIntensity, "sun_intensity", 4.0f);
    defineParam(sunDiscRadiance, "sun_disc_radiance", 2000.0f);
    defineParam(ambientStrength, "ambient_strength", 1.0f);
    defineParam(terrainHeight, "terrain_height", 2600.0f);
    defineParam(terrainScale, "terrain_scale", 9000.0f);
    defineParam(seed, "seed", 2.0f);
    defineParam(seaLevel, "sea_level", -1e9f);
    defineParam(valleyDirection, "valley_direction", 0.0f);
    defineParam(floorWidth, "floor_width", 500.0f);
    defineParam(wallWidth, "wall_width", 450.0f);
    defineParam(rimHeight, "rim_height", 1000.0f);
    defineParam(meander, "meander", 900.0f);
  }

  void init()
  {
    pi = 3.14159265358979f;
    sunDir = normalize(sunDirection);
  }

  float hash2(float x, float z)
  {
    float h = sin(x * 127.1f + z * 311.7f + seed * 74.7f) * 43758.5453f;
    return h - floor(h);
  }

  float vnoise(float x, float z)
  {
    float ix = floor(x), iz = floor(z);
    float fx = x - ix, fz = z - iz;
    float ux = fx * fx * (3.0f - 2.0f * fx);
    float uz = fz * fz * (3.0f - 2.0f * fz);
    float a = hash2(ix, iz), b = hash2(ix + 1.0f, iz);
    float c = hash2(ix, iz + 1.0f), d = hash2(ix + 1.0f, iz + 1.0f);
    return (a + (b - a) * ux) + ((c + (d - c) * ux) - (a + (b - a) * ux)) * uz;
  }

  // Fractal noise, 0..1.
  float fbm(float x, float z, int octaves)
  {
    float sum = 0.0f, amp = 0.5f, norm = 0.0f;
    for (int i = 0; i < octaves; i++) {
      sum += amp * vnoise(x, z);
      norm += amp;
      float nx = x * 1.9f - z * 0.9f;
      float nz = x * 0.9f + z * 1.9f;
      x = nx + 5.3f;
      z = nz + 2.1f;
      amp *= 0.5f;
    }
    return sum / norm;
  }

  // Ridged fractal noise, 0..1: sharp crests.
  float ridged(float x, float z, int octaves)
  {
    float sum = 0.0f, amp = 0.5f, norm = 0.0f;
    for (int i = 0; i < octaves; i++) {
      float n = 1.0f - fabs(2.0f * vnoise(x, z) - 1.0f);
      sum += amp * n * n;
      norm += amp;
      float nx = x * 1.8f - z * 1.0f;
      float nz = x * 1.0f + z * 1.8f;
      x = nx + 3.1f;
      z = nz + 1.7f;
      amp *= 0.5f;
    }
    return sum / norm;
  }

  // A glacial valley carved through mountains: a flat, winding, forested floor between
  // near-vertical granite walls that rise straight into the peaks around it, which keep
  // rising into higher ranges further off. The valley runs along valley_direction (degrees
  // from -Z towards +X); rim_height is about how high the walls stand above the floor.
  float height(float x, float z, int octaves)
  {
    float a = valleyDirection * pi / 180.0f;
    float along = x * sin(a) - z * cos(a);
    float across = x * cos(a) + z * sin(a);
    // The floor's centre wanders.
    float centre = meander * (sin(along / 3500.0f) + 0.6f * (vnoise(along / 2500.0f, 4.0f) - 0.5f));
    float d = fabs(across - centre);
    // The mountains the valley is cut through: higher further from it.
    float far = clamp((d - floorWidth - wallWidth) / 8000.0f, 0.0f, 1.0f);
    float mountains = rimHeight * (0.8f + 1.1f * ridged(x / 7000.0f, z / 7000.0f, octaves) + 1.4f * far *
                      ridged(x / 9000.0f + 5.0f, z / 9000.0f, 4));
    // The cut: flat floor, then walls that steepen into cliffs and meet the mountains.
    float u = clamp((d - floorWidth) / wallWidth, 0.0f, 1.0f);
    float wall = 1.0f - pow(1.0f - u, 2.4f);
    float h = mountains * wall;
    // Gullies down the walls (noise stretched across the valley, so it runs down the faces),
    // and a little roughness on the floor.
    float gully = fbm(along / 110.0f, across / 500.0f, 4) - 0.5f;
    h += gully * 260.0f * u * (1.0f - u) * 4.0f + (fbm(x / 200.0f, z / 200.0f, 3) - 0.5f) * 6.0f;
    return h;
  }

  // Terrain with water filling everything below sea_level (off by default).
  float surface(float x, float z, int octaves)
  {
    return max(height(x, z, octaves), seaLevel);
  }

  float3 skyLookup(float3 d)
  {
    float lon = atan2(d.x, -d.z);
    float lat = asin(clamp(d.y, -1.0f, 1.0f));
    float u = lon / (2.0f * pi) + 0.5f;
    float v = lat / pi + 0.5f;
    float x = sky.bounds.x1 + u * sky.bounds.width() - 0.5f;
    float y = sky.bounds.y1 + v * sky.bounds.height() - 0.5f;
    float4 c = bilinear(sky, x, y);
    return float3(c.x, c.y, c.z);
  }

  void process(int2 pos)
  {
    float u = (pos.x - ref.bounds.x1 + 0.5f) / ref.bounds.width() - 0.5f;
    float v = (pos.y - ref.bounds.y1 + 0.5f) / ref.bounds.height() - 0.5f;
    float3 camDir = float3(u * haperture / focal, v * vaperture / focal, -1.0f);
    float3 dir = normalize(float3(dot(camRow0, camDir), dot(camRow1, camDir), dot(camRow2, camDir)));

    // March until the ray drops below the terrain.
    float t = 10.0f;
    bool hit = false;
    for (int i = 0; i < 1200; i++) {
      float3 p = camPosition + dir * t;
      float dy = p.y - surface(p.x, p.z, 7);
      if (dy < 0.001f * t) {
        hit = true;
        break;
      }
      if (t > 250000.0f) {
        // Far enough that the terrain would be lost in haze anyway: downward rays count
        // as hitting it here, so the haze has a depth to work with.
        hit = dir.y < 0.0f;
        break;
      }
      if (p.y > terrainHeight * 1.5f && dir.y > 0.0f)
        break;
      t += max(dy * 0.4f, 1.0f + 0.0015f * t);
    }

    // Downward rays that ran out of steps before reaching the terrain still end on it,
    // far away; otherwise they would show sky below the horizon.
    if (!hit && dir.y < 0.0f) {
      hit = true;
      t = min(t, 250000.0f);
    }

    if (!hit) {
      float3 c = skyLookup(dir);
      float mu = dot(dir, sunDir);
      float disc = clamp((mu - cos(0.5f * pi / 180.0f)) / 0.00002f, 0.0f, 1.0f);
      c += sunColor * sunDiscRadiance * disc;
      dst() = float4(c.x, c.y, c.z, 0.0f);
      return;
    }

    // Refine the hit a little.
    float tPrev = t - max(1.0f + 0.0015f * t, 0.0f);
    for (int i = 0; i < 10; i++) {
      float tm = 0.5f * (t + tPrev);
      float3 pm = camPosition + dir * tm;
      if (pm.y - surface(pm.x, pm.z, 7) < 0.0f)
        t = tm;
      else
        tPrev = tm;
    }
    float3 p = camPosition + dir * t;
    float e = 4.0f + 0.002f * t;
    float hx = surface(p.x + e, p.z, 7) - surface(p.x - e, p.z, 7);
    float hz = surface(p.x, p.z + e, 7) - surface(p.x, p.z - e, 7);
    float3 n = normalize(float3(-hx, 2.0f * e, -hz));

    // Soft shadow from the terrain towards the sun.
    float shadow = 1.0f;
    float s = 30.0f;
    for (int i = 0; i < 80; i++) {
      float3 q = p + sunDir * s;
      float dq = q.y - surface(q.x, q.z, 5);
      shadow = min(shadow, clamp(8.0f * dq / s, 0.0f, 1.0f));
      if (shadow <= 0.0f || q.y > terrainHeight * 1.2f)
        break;
      s += max(dq * 0.5f, 20.0f + 0.01f * s);
    }

    float slope = 1.0f - n.y;
    // Forest on the floor and gentle slopes, pale granite on the walls.
    float patch = fbm(p.x / 300.0f, p.z / 300.0f, 3);
    float3 grass = float3(0.03f, 0.045f, 0.025f) + float3(0.02f, 0.012f, 0.005f) * patch;
    float3 rock = float3(0.32f, 0.3f, 0.27f);
    float3 albedo = grass + (rock - grass) * clamp((slope - 0.3f) * 3.0f + (patch - 0.65f) * 2.0f, 0.0f, 1.0f);
    bool water = p.y <= seaLevel + 0.5f;
    if (water) {
      // Dark water with a little of the sky reflected in it.
      n = float3(0.0f, 1.0f, 0.0f);
      albedo = float3(0.02f, 0.03f, 0.035f);
    }
    float3 skyUp = skyLookup(float3(0.0f, 1.0f, 0.0f));
    float3 skyHorizon = skyLookup(normalize(float3(-sunDir.x, 0.05f, -sunDir.z)));
    float3 ambient = (skyUp * (0.5f + 0.5f * n.y) + skyHorizon * 0.3f) * ambientStrength;
    float3 lit = albedo * (sunColor * sunIntensity * max(dot(n, sunDir), 0.0f) * shadow / pi + ambient);
    if (water) {
      float3 r = skyLookup(float3(dir.x, -dir.y, dir.z));
      lit += r * (0.02f + 0.3f * pow(1.0f - fabs(dir.y), 5.0f));
    }
    dst() = float4(lit.x, lit.y, lit.z, t);
  }
};
