 addUserKnob {6 inherit_atmos l "inherit from atmos" t "With an EzAtmosScatter node in the 'atmos' input, take its haze density, haze height and hdri rotation, so the haze matches its sky." +STARTLINE}
 inherit_atmos true
 addUserKnob {4 haze_color_from l "haze color from" t "Atmos Sun + Sky: EzAtmosScatter's atmos_haze_sun and atmos_haze_sky layers, looked up in each pixel's view direction; shadows remove only the sun part. Atmos Layer: one layer of the atmos input ('atmos layer'), split by 'sun share'. Color: one flat colour, split by 'sun share'." M {"Atmos Sun + Sky" "Atmos Layer" Color}}
 addUserKnob {7 sun_share l "sun share" t "With Atmos Layer or Color: how much of the haze light comes from the sun (and so can be shadowed) rather than the sky."}
 sun_share 0.6
 addUserKnob {6 match_horizon l "match horizon sky" t "With an EzAtmosScatter atmos input, haze far away takes the light of that atmosphere's own sky (its atmos_inscatter over 1 - atmos_transmittance) instead of the light at camera height. At sunset the air far away gets dimmer, redder sunlight, so without this distant terrain fades to a haze brighter than the sky behind it." +STARTLINE}
 match_horizon true
 addUserKnob {7 match_distance l "match distance (km)" t "Distance over which the haze light changes from the camera's to the horizon sky's." R 1 200}
 match_distance 20
 addUserKnob {41 atmos_layer l "atmos layer" t "Layer of the atmos input to use: atmos_haze_color for EzAtmosScatter, rgba for a plain lat-long." T AtmosPick.in1}
 addUserKnob {18 haze_color l "haze color" t "Haze colour when 'haze color from' is Color, or no atmos input is connected."}
 haze_color {0.6 0.65 0.75}
 addUserKnob {7 haze_color_gain l "haze brightness" t "Multiplies the haze colour." R 0 4}
 haze_color_gain 1
 addUserKnob {18 haze_tint l "haze tint" t "Tints all the haze light, e.g. warm brown for smoke. White leaves it as the atmosphere made it."}
 haze_tint {1 1 1}
 addUserKnob {18 haze_density l "haze density (1/m)" t "How much the haze dims light per metre at camera height. Ignored when inheriting."}
 haze_density {0.0001 0.0001 0.0001}
 addUserKnob {7 haze_amount l "haze amount" t "Multiplies the haze density." R 0 10}
 haze_amount 1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins by about two thirds. Ignored when inheriting." R 0.05 10}
 haze_height 1.2
 addUserKnob {7 haze_start l "haze start (m)" t "Distance from the camera where the haze begins." R 0 10000}
 addUserKnob {7 max_distance l "max distance (km)" t "Caps the hazed distance. 0 = no cap." R 0 200}
 addUserKnob {7 env_rotation l "atmos rotation" t "Rotation of the atmos lat-long in degrees. Ignored when inheriting." R -180 180}
 addUserKnob {26 volume_divider l "Fog and Noise"}
 addUserKnob {4 haze_mode l mode t "Fast: the haze alone, worked out exactly in one step. Volumetric: marches each ray so the fog layer and noise below can change the density along it." M {Fast Volumetric}}
 addUserKnob {4 steps l quality t "Samples along each ray in Volumetric mode." M {"Draft (16)" "Normal (48)" "High (96)"}}
 steps "Normal (48)"
 addUserKnob {7 fog_density l "fog density (1/km)" t "How thick the fog layer is. 1 dims light by about two thirds every kilometre." R 0 5}
 addUserKnob {7 fog_top l "fog top (m)" t "Altitude the fog fills up to, e.g. the valley floor plus a few hundred metres." R -500 5000}
 fog_top 1000
 addUserKnob {7 fog_softness l "fog softness (m)" t "How gradually the fog fades out around its top." R 0 2000}
 fog_softness 300
 addUserKnob {7 noise_amount l "noise amount" t "How much world-space noise breaks up the fog."}
 addUserKnob {7 noise_on_haze l "noise on haze" t "How much of the noise also applies to the thin haze, not only the fog."}
 noise_on_haze 0.3
 addUserKnob {7 noise_size l "noise size (m)" t "Size of the largest wisps and banks." R 10 20000}
 noise_size 2000
 addUserKnob {7 noise_stretch l "noise flatten" t "Squashes the noise vertically so it forms banks and layers rather than blobs." R 1 10}
 noise_stretch 3
 addUserKnob {3 noise_detail l "noise detail" t "Octaves of noise: more adds finer wisps."}
 noise_detail 4
 addUserKnob {7 noise_roughness l "noise roughness" t "How strong the finer layers are: higher gives grainier, more detailed noise." R 0.3 0.8}
 noise_roughness 0.5
 addUserKnob {7 noise_sharpness l "noise sharpness" t "Steepens the noise: 1 is soft blobs, higher gives patches with crisp edges." R 1 6}
 noise_sharpness 1
 addUserKnob {13 noise_wind l "wind (m/s)" t "Drifts the noise over time."}
 noise_wind {5 0 0}
 addUserKnob {7 noise_seed l "noise seed" t "Changes the noise pattern." R 0 100}
 noise_seed 1
 addUserKnob {26 shadow_divider l "Sun and Shadows"}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up. Taken from the atmos input's sun direction when inheriting (set its 'sun from' to Manual so the two agree)."}
 sun_direction {0 0.1 -1}
 addUserKnob {7 sun_scatter l "sun scatter" t "Multiplies the sunlit haze: how bright the light shafts are." R 0 4}
 sun_scatter 1
 addUserKnob {7 sky_scatter l "sky scatter" t "Multiplies the sky-lit haze: how bright the haze in shadow is." R 0 4}
 sky_scatter 1
 addUserKnob {7 shadow_strength l "shadow strength" t "How much sunlight the haze loses where the terrain blocks the sun. 1 is physical; 0 turns volumetric shadows off."}
 shadow_strength 1
 addUserKnob {18 shadow_fill l "shadow fill" t "Puts back a tinted share of the sunlight the shadowed haze lost. 0 is physical."}
 shadow_fill {0 0 0}
 addUserKnob {7 shadow_distance l "shadow distance (km)" t "How far towards the sun each point looks for terrain that blocks it." R 0.1 100}
 shadow_distance 20
 addUserKnob {7 penumbra l "penumbra (deg)" t "Softness of the shadow edges: the sun's apparent size is about 0.5. Larger is softer but grainier." R 0 5}
 penumbra 0.5
 addUserKnob {7 occluder_thickness l "occluder thickness (m)" t "How deep each surface in the depth is taken to be. Mountains are solid (the default); lower it for thin objects like trees." R 1 1e+09}
 occluder_thickness 1000000000
 addUserKnob {4 shadow_quality l "shadow quality" t "Samples towards the sun (8, 16, 32) and how often along the view ray they are taken." M {Draft Normal High}}
 shadow_quality Normal
 addUserKnob {26 shadow_note l "" +STARTLINE T "Screen space: only terrain in frame casts shadows. Shadows need Volumetric mode or match horizon sky to step the ray; Fast mode steps 16 slabs."}
 addUserKnob {26 cloud_divider l "Cloud Gaps"}
 addUserKnob {7 cloud_cover l "cloud cover" t "A layer of cloud that blocks the sun except through gaps, so beams of light fall through them into the haze. 0 is no cloud (off), 1 all cloud; 0.8 leaves a few gaps."}
 addUserKnob {7 cloud_height l "cloud height (m)" t "Altitude of the cloud layer, in metres. Higher makes longer beams." R 0 10000}
 cloud_height 3000
 addUserKnob {7 cloud_size l "gap size (m)" t "Size of the gaps and the cloud between them." R 50 20000}
 cloud_size 1500
 addUserKnob {7 cloud_softness l "gap softness" t "How soft the edges of the gaps are." R 0.01 1}
 cloud_softness 0.15
 addUserKnob {4 cloud_from l "gaps from" t "Noise: made-up gaps of gap size. Sky (from atmos): the clouds in the HDRI the atmos node is lit by, already turned with its skydome, work as a gobo: blue sky lets the sun through, cloud doesn't, so the beams line up with the gaps you see. Needs the atmos node on output as Lat-long. Clouds Input: the same from a sky (or keyed matte) you plug into the clouds input, which appears on the node while this is picked. Cloud cover is then how blue a gap must be; cloud height is how high those clouds are. Falls back to Noise when the sky isn't there." M {Noise "Sky (from atmos)" "Clouds Input"}}
 addUserKnob {3 clouds_source l "clouds source" +INVISIBLE}
 clouds_source {{"\[python -execlocal \{a = nuke.thisNode().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nm = int(nuke.thisNode()\['cloud_from'].getValue())\nret = 1 if m == 2 and nuke.thisNode().input(3) is not None else (2 if m == 1 and a is not None and 'atmos_clouds.red' in a.channels() and not (a.knob('output_mapping') and int(a\['output_mapping'].getValue()) != 0) else 0)\}]"}}
 addUserKnob {4 cloud_key l "gap key" t "What in the clouds input counts as a gap. Blue Sky: keyed from the colours (blue sky and the sun). Alpha: a matte you keyed yourself in the clouds input's alpha, 1 where there is cloud and 0 in the gaps. Cloud cover is then the alpha below which the sun gets through (0.5 is half way)." M {"Blue Sky" Alpha}}
 addUserKnob {7 cloud_breakup l breakup t "Noise that roughens the edges of the gaps and thins them in streaks, so the beams break up instead of being clean cones of light. 0 is off."}
 addUserKnob {7 cloud_breakup_size l "breakup size (m)" t "Size of the breakup noise on the cloud layer. Smaller is finer streaks in the beams." R 10 5000}
 cloud_breakup_size 300
 addUserKnob {26 surface_divider l "Surface Light"}
 addUserKnob {6 surface_add l "add surface light" t "Adds the sunlight falling on the terrain to the plate. Off: it is only written to the surface_sunlight layer. Leave off for CG already lit by the same sun." +STARTLINE}
 addUserKnob {7 surface_strength l "surface light strength" t "Multiplies the surface light." R 0 10}
 surface_strength 1
 addUserKnob {18 surface_color l "sun light color" t "Colour and brightness of the sunlight on the terrain."}
 surface_color {1 0.8 0.6}
 addUserKnob {4 albedo_from l "albedo from" t "Plate: use the plate's own colour as the surface colour. Constant: use 'albedo'." M {Plate Constant}}
 addUserKnob {18 albedo}
 albedo {0.15 0.15 0.15}
}
 Input {
  inputs 0
  name camera
  xpos 300
  ypos -300
  number 1
 }
 Input {
  inputs 0
  name atmos
  xpos 600
  ypos -300
  number 2
 }
set Nfeaf4800 [stack 0]
add_layer {atmos_clouds atmos_clouds.red atmos_clouds.green atmos_clouds.blue atmos_clouds.alpha}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_clouds
  fromInput2 {{0} B}
  mappings "4 atmos_clouds.red 0 0 rgba.red 0 0 atmos_clouds.green 0 1 rgba.green 0 1 atmos_clouds.blue 0 2 rgba.blue 0 2 atmos_clouds.alpha 0 3 rgba.alpha 0 3"
  name AtmosCloudsPick
  xpos 900
  ypos -250
 }
 Input {
  inputs 0
  name clouds
  xpos 1050
  ypos -300
  number 3
 }
 Constant {
  inputs 0
  format "8 4 0 0 8 4 1 EzDepthHaze_tiny"
  name NoClouds
  xpos 1150
  ypos -300
 }
 Switch {
  inputs 3
  which {{parent.clouds_source}}
  name CloudsOrNone
  xpos 1050
  ypos -200
 }
set Nfeb04500 [stack 0]
push $Nfeaf4800
add_layer {atmos_inscatter atmos_inscatter.red atmos_inscatter.green atmos_inscatter.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_inscatter
  fromInput2 {{0} B}
  mappings "4 atmos_inscatter.red 0 0 rgba.red 0 0 atmos_inscatter.green 0 1 rgba.green 0 1 atmos_inscatter.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosSkyScatter
  xpos 750
  ypos -200
 }
push $Nfeaf4800
add_layer {atmos_transmittance atmos_transmittance.red atmos_transmittance.green atmos_transmittance.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_transmittance
  fromInput2 {{0} B}
  mappings "4 atmos_transmittance.red 0 0 rgba.red 0 0 atmos_transmittance.green 0 1 rgba.green 0 1 atmos_transmittance.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosSkyTransmittance
  xpos 900
  ypos -200
 }
 Expression {
  expr0 "max(1 - r, 0.02)"
  expr1 "max(1 - g, 0.02)"
  expr2 "max(1 - b, 0.02)"
  name AtmosSkyVeil
  xpos 900
  ypos -160
 }
 Merge2 {
  inputs 2
  operation divide
  output rgb
  name AtmosSkyPerHaze
  xpos 750
  ypos -120
 }
push $Nfeaf4800
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_haze_color
  fromInput2 {{0} B}
  mappings "4 atmos_haze_color.red 0 0 rgba.red 0 0 atmos_haze_color.green 0 1 rgba.green 0 1 atmos_haze_color.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosPick
  xpos 600
  ypos -200
 }
set Nfeaf5c00 [stack 0]
 Multiply {
  channels rgb
  value {{"1 - parent.sun_share"}}
  name LayerSkyShare
  xpos 650
  ypos -170
 }
push $Nfeaf4800
add_layer {atmos_haze_sky atmos_haze_sky.red atmos_haze_sky.green atmos_haze_sky.blue}
 Shuffle2 {
