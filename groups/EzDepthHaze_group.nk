 BlinkScript {
  inputs 3
  recompileCount 2
  KernelDescription "3 \"EzDepthHazeShape\" iterate pixelWise 0f5c582e9f8e659be61567599a53665bec9fc94d9d459fc0e781e52204e82e29 4 \"src\" Read Point \"trans\" Read Point \"depth\" Read Point \"dst\" Write Point 3 \"curve\" Float 1 AACAPw== \"mode\" Int 1 AAAAAA== \"sky_threshold\" Float 1 gJYYSw== 3 \"curve\" 1 1 Default \"mode\" 1 1 Default \"skyThreshold\" 1 1 Default 0"
  kernelSource "// EzDepthHazeShape: the silhouette control, bending how the haze builds with distance.\n//\n// The haze's optical depth tau (T = exp(-tau)) is bent around tau = 0.25: with\n// `curve` above 1, thin haze (near terrain) gets thinner and thick haze (far ranges) closes\n// in faster, so far ridges become flat layers the colour of the haze while the foreground\n// keeps its contrast. The haze light is scaled by the same change in (1 - T), so the result\n// stays plate * T + light.\n//\n// Inputs: `src` the pass to reshape, `trans` the transmittance pass, `depth` the raw depth in\n// red (sky pixels are left alone). Mode 0 writes the new\n// transmittance; mode 1 scales a light pass (sun, sky, ...) to match it.\n\nkernel EzDepthHazeShape : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eRead, eAccessPoint, eEdgeClamped> trans;\n  Image<eRead, eAccessPoint, eEdgeClamped> depth;\n  Image<eWrite> dst;\n\nparam:\n  float curve;\n  int mode;\n  float skyThreshold;\n\n  void define()\n  \{\n    defineParam(curve, \"curve\", 1.0f);\n    defineParam(mode, \"mode\", 0);\n    defineParam(skyThreshold, \"sky_threshold\", 1e7f);\n  \}\n\n  float shaped(float t)\n  \{\n    float tau = -log(clamp(t, 1e-6f, 1.0f));\n    // Around tau = 0.25 (a fifth of the plate hidden): thinner haze thins, thicker thickens.\n    return exp(-tau * pow(tau / 0.25f, curve - 1.0f));\n  \}\n\n  float scale(float t)\n  \{\n    float veil = 1.0f - clamp(t, 0.0f, 1.0f);\n    if (veil < 1e-6f)\n      return 0.0f;\n    return (1.0f - shaped(t)) / veil;\n  \}\n\n  void process()\n  \{\n    float4 s = src();\n    float4 t = trans();\n    // The sky (no depth, or past sky depth) keeps its haze as it was: only terrain is reshaped.\n    float raw = depth().x;\n    bool sky = raw <= 0.0f || raw >= skyThreshold;\n    if (curve == 1.0f || sky) \{\n      dst() = s;\n      return;\n    \}\n    if (mode == 0)\n      dst() = float4(shaped(t.x), shaped(t.y), shaped(t.z), s.w);\n    else\n      dst() = float4(s.x * scale(t.x), s.y * scale(t.y), s.z * scale(t.z), s.w);\n  \}\n\};\n"
  rebuild ""
  EzDepthHazeShape_curve {{"1 + 1.5 * parent.silhouette"}}
  EzDepthHazeShape_mode {{1}}
  EzDepthHazeShape_sky_threshold {{parent.sky_threshold}}
  rebuild_finalise ""
  name Silhouette_sky
  xpos -180
  ypos -20
 }
