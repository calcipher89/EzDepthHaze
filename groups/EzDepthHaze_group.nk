  name Pass_P
  xpos 420
  ypos -80
 }
 Reformat {
  type "to box"
  box_width {{plate.width}}
  box_height {{plate.height}}
  box_fixed true
  resize distort
  name Full_P
  xpos 420
  ypos -50
 }
