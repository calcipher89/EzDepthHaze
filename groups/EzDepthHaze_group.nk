  expr1 "((acos(clamp((sin(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.x + sin(lat) * Pass_sun.EzDepthHaze_sun_direction.y - cos(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.z) / max(sqrt(Pass_sun.EzDepthHaze_sun_direction.x * Pass_sun.EzDepthHaze_sun_direction.x + Pass_sun.EzDepthHaze_sun_direction.y * Pass_sun.EzDepthHaze_sun_direction.y + Pass_sun.EzDepthHaze_sun_direction.z * Pass_sun.EzDepthHaze_sun_direction.z), 1e-6), -1, 1)) * 180 / pi) > 2.5 && (acos(clamp((sin(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.x + sin(lat) * Pass_sun.EzDepthHaze_sun_direction.y - cos(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.z) / max(sqrt(Pass_sun.EzDepthHaze_sun_direction.x * Pass_sun.EzDepthHaze_sun_direction.x + Pass_sun.EzDepthHaze_sun_direction.y * Pass_sun.EzDepthHaze_sun_direction.y + Pass_sun.EzDepthHaze_sun_direction.z * Pass_sun.EzDepthHaze_sun_direction.z), 1e-6), -1, 1)) * 180 / pi) < 3.5) ? 1 : (g / (1 + g)) * 0.3 + m * m * (3 - 2 * m) * 0.60 * 0.8"
  expr2 "((acos(clamp((sin(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.x + sin(lat) * Pass_sun.EzDepthHaze_sun_direction.y - cos(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.z) / max(sqrt(Pass_sun.EzDepthHaze_sun_direction.x * Pass_sun.EzDepthHaze_sun_direction.x + Pass_sun.EzDepthHaze_sun_direction.y * Pass_sun.EzDepthHaze_sun_direction.y + Pass_sun.EzDepthHaze_sun_direction.z * Pass_sun.EzDepthHaze_sun_direction.z), 1e-6), -1, 1)) * 180 / pi) > 2.5 && (acos(clamp((sin(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.x + sin(lat) * Pass_sun.EzDepthHaze_sun_direction.y - cos(lon) * cos(lat) * Pass_sun.EzDepthHaze_sun_direction.z) / max(sqrt(Pass_sun.EzDepthHaze_sun_direction.x * Pass_sun.EzDepthHaze_sun_direction.x + Pass_sun.EzDepthHaze_sun_direction.y * Pass_sun.EzDepthHaze_sun_direction.y + Pass_sun.EzDepthHaze_sun_direction.z * Pass_sun.EzDepthHaze_sun_direction.z), 1e-6), -1, 1)) * 180 / pi) < 3.5) ? 0 : (b / (1 + b)) * 0.3 + m * m * (3 - 2 * m) * 0.15 * 0.8"
