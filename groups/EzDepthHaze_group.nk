set Nfeb05400 [stack 0]
 Merge2 {
  inputs 2
  operation plus
  output rgb
  name HazeTotalLight
  xpos 550
  ypos -110
 }
 Expression {
  expr0 "max(r, 1e-5)"
  expr1 "max(g, 1e-5)"
  expr2 "max(b, 1e-5)"
  name AtmosHazeColorSafe
  xpos 600
  ypos -160
 }
 Merge2 {
  inputs 2
  operation divide
  output rgb
  name AtmosSkyRatio
  xpos 750
  ypos -110
 }
 Blur {
  size {96 24}
  name AtmosSkySoften
  xpos 750
  ypos -100
 }
 Crop {
  box {{0} {"input.height / 2 + 2"} {input.width} {input.height}}
  crop false
  name AtmosSkyUpper
  xpos 750
  ypos -90
 }
 AdjBBox {
  numpixels {{input.height}}
  name AtmosSkyExtend
  xpos 750
  ypos -60
 }
 Crop {
  box {{0} {0} {AtmosSkyPerHaze.width} {AtmosSkyPerHaze.height}}
  crop false
  name AtmosSkyFull
  xpos 750
  ypos -30
 }
