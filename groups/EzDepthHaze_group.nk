  EzDepthHaze_env_screen {{"\[python -execlocal \{a = nuke.thisGroup().input(2)\nwhile a is not None and not a.knob('haze_density'):\n    a = a.input(0) if a.inputs() else None\nret = 1 if a is not None and a.knob('output_mapping') and int(a\['output_mapping'].getValue()) == 2 and a.input(3) is not None else 0\}]"}}
