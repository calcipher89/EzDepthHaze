 BlinkScript {
  inputs 2
  recompileCount 2
  KernelDescription "3 \"EzDepthHazeSmooth\" iterate pixelWise 658ba452864882b2db0d295ffa9ea6ce5c81b09f87db3d7136dd70dc120b39f3 3 \"src\" Read Random \"depth\" Read Random \"dst\" Write Point 3 \"radius\" Float 1 AAAAQA== \"edge\" Float 1 j8L1PA== \"antialias\" Float 1 AACAPw== 3 \"radius\" 1 1 Default \"edge\" 1 1 Default \"antialias\" 1 1 Default 0"
  kernelSource "// EzDepthHazeSmooth: grain smoothing and edge antialiasing for EzDepthHaze's haze passes.\n//\n// The haze is smooth by nature; what grain it has comes from the per-pixel sampling. Away\n// from depth edges this averages each pixel with its neighbours at about the same depth, so\n// the grain melts while ridge lines stay sharp. Right at a depth edge that leaves the grain\n// and the stair-stepping of the depth itself, so within `antialias` pixels of an edge it\n// blends across it instead (like a small 3x3 blur, 1x to 3x), as the plate's own\n// antialiased edge does. Pixels with no depth (sky) count as infinitely far.\n//\n// Inputs: `src` the pass to smooth, `depth` with the raw depth in red (as EzDepthHaze reads it).\n\nkernel EzDepthHazeSmooth : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eRead, eAccessRandom, eEdgeClamped> depth;\n  Image<eWrite> dst;\n\nparam:\n  float radius;\n  float edge;\n  float antialias;\n\n  void define()\n  \{\n    defineParam(radius, \"radius\", 2.0f);\n    defineParam(edge, \"edge\", 0.03f);\n    defineParam(antialias, \"antialias\", 1.0f);\n  \}\n\n  float key(float d)\n  \{\n    // Depth on a log scale, so \"about the same depth\" means the same ratio near and far.\n    return d > 0.0f ? log(d) : 1e6f;\n  \}\n\n  void process(int2 pos)\n  \{\n    float kc = key(depth(pos.x, pos.y).x);\n\n    // Near a depth edge: blend across it.\n    int a = int(antialias + 0.5f);\n    if (a > 0) \{\n      bool atEdge = false;\n      for (int dy = -a; dy <= a && !atEdge; dy++)\n        for (int dx = -a; dx <= a; dx++)\n          if (fabs(key(depth(pos.x + dx, pos.y + dy).x) - kc) > edge * 3.0f) \{\n            atEdge = true;\n            break;\n          \}\n      if (atEdge) \{\n        float s2 = 0.5f * antialias * antialias + 0.25f;\n        float4 sum = float4(0.0f);\n        float wsum = 0.0f;\n        for (int dy = -a; dy <= a; dy++)\n          for (int dx = -a; dx <= a; dx++) \{\n            float w = exp(-(dx * dx + dy * dy) / s2);\n            sum += src(pos.x + dx, pos.y + dy) * w;\n            wsum += w;\n          \}\n        dst() = sum / wsum;\n        return;\n      \}\n    \}\n\n    // Elsewhere: smooth only between pixels at about the same depth.\n    int r = int(radius + 0.5f);\n    if (r <= 0) \{\n      dst() = src(pos.x, pos.y);\n      return;\n    \}\n    float sigma2 = 2.0f * (radius * 0.6f) * (radius * 0.6f);\n    float4 sum = float4(0.0f);\n    float wsum = 0.0f;\n    for (int dy = -r; dy <= r; dy++) \{\n      for (int dx = -r; dx <= r; dx++) \{\n        float kd = (key(depth(pos.x + dx, pos.y + dy).x) - kc) / edge;\n        float w = exp(-(dx * dx + dy * dy) / sigma2 - kd * kd);\n        sum += src(pos.x + dx, pos.y + dy) * w;\n        wsum += w;\n      \}\n    \}\n    dst() = sum / wsum;\n  \}\n\};\n"
  rebuild ""
  EzDepthHazeSmooth_radius {{"parent.smooth * (\$gui ? (parent.viewer_resolution==0 ? 1 : parent.viewer_resolution==1 ? 0.5 : 0.25) : 1)"}}
  EzDepthHazeSmooth_antialias {{"parent.edge_antialias * (\$gui ? (parent.viewer_resolution==0 ? 1 : parent.viewer_resolution==1 ? 0.5 : 0.25) : 1)"}}
  rebuild_finalise ""
  name Smooth_sun_free
  xpos 900
  ypos 1902
 }
