Group {
 name EzDepthHaze1
 onCreate "n = nuke.thisNode()\nif n.knob('tool_code') and not n\['advanced'].value():\n    d = \{\}\n    exec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\n    d\['set_advanced'](n, False)\n"
 knobChanged "k = nuke.thisKnob().name()\nn = nuke.thisNode()\nif k == 'showPanel' and n.knob('tool_code'):\n    d = \{\}\n    exec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\n    d\['set_advanced'](n, False)\n    d\['refresh_look_menu'](n)\nelif k in \['preset', 'advanced', 'my_looks', 'look_strength', 'easy_haze', 'easy_warmth', 'easy_glow', 'easy_shafts', 'easy_fog', 'easy_fog_height', 'easy_fog_softness', 'easy_texture', 'easy_texture_scale', 'easy_texture_detail', 'easy_texture_sharpness'] and nuke.GUI and n.shown():\n    d = \{\}\n    exec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\n    if k == 'preset':\n        d\['apply_look'](n)\n    elif k == 'advanced':\n        d\['set_advanced'](n)\n    elif k == 'my_looks':\n        d\['load_look'](n)\n    else:\n        d\['apply_easy'](n)\n"
 tile_color 0x6a8fa5ff
 selected true
 addUserKnob {20 easy l Easy}
 addUserKnob {26 looks_divider l Look}
 addUserKnob {4 preset l look t "A starting look, applied as soon as you pick it and fitted to this shot: the depth and camera are measured at this frame and haze amount, fog height, noise and distances are scaled to match the demo the presets were tuned on. Afterwards it offers to move the EzAtmosScatter sun to where the look wants it:\nClear Day: sun high, 30-45 degrees, from the side; white, full strength.\nGolden Hour: sun low, 2-6 degrees, in front of the camera; warm.\nValley Fog: sun low morning sun, 8-15 degrees; slightly warm.\nSmoke Haze: sun any; a dimmed, reddened sun reads best.\nOvercast Mist: sun any; it hardly shows." M {"Clear Day" "Golden Hour" "Valley Fog" "Smoke Haze" "Overcast Mist"}}
 preset "Golden Hour"
 addUserKnob {22 apply_preset l apply t "Applies the look again, fitted to the shot: e.g. after connecting the plate and camera, or to start over." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['apply_look'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {7 look_strength l "look strength" t "From clear air (0) to the full look (1)."}
 look_strength 1
 addUserKnob {26 adjust_divider l Adjust}
 addUserKnob {7 easy_haze l haze t "How thick the haze is." R 0 3}
 easy_haze 1
 addUserKnob {7 easy_warmth l warmth t "Cooler (blue) to warmer (orange) haze light." R -1 1}
 addUserKnob {7 easy_glow l glow t "How bright the sunlit haze is, around and towards the sun." R 0 3}
 easy_glow 1
 addUserKnob {7 easy_shafts l shafts t "How strongly the terrain shadows the haze: 0 is no shafts." R 0 2}
 easy_shafts 1
 addUserKnob {7 easy_fog l fog t "How dense the valley fog is." R 0 3}
 easy_fog 1
 addUserKnob {7 easy_fog_height l "fog height" t "Lower or raise the fog, in steps of the terrain's height range. Low and negative for low-lying fog in the valley floors." R -1 1}
 addUserKnob {7 easy_fog_softness l "fog softness" t "How gradually the fog fades out at its top: low gives a crisp fog bank, high a soft mist." R 0.1 3}
 easy_fog_softness 1
 addUserKnob {7 easy_texture l texture t "How much the noise breaks up the haze and fog." R 0 3}
 easy_texture 1
 addUserKnob {7 easy_texture_scale l "texture scale" t "Size of the noise patches: lower gives smaller, busier patches." R 0.2 3}
 easy_texture_scale 1
 addUserKnob {7 easy_texture_detail l "texture detail" t "Fine detail in the noise: more layers of smaller wisps on the big shapes." R 0 2}
 easy_texture_detail 1
 addUserKnob {7 easy_texture_sharpness l "texture sharpness" t "Soft blobs (0) to patches with crisp edges (2)." R 0 2}
 addUserKnob {22 surprise_me l "surprise me" t "Random adjustments within tasteful limits." T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['surprise'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n" +STARTLINE}
 addUserKnob {22 reset_easy l reset t "Centres the sliders, back to the look as applied." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['reset_sliders'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {6 show_before l before t "Shows the plate without haze, to compare." -STARTLINE}
 addUserKnob {26 save_divider l "My Looks"}
 addUserKnob {4 my_looks l "saved looks" t "Looks saved by you (User) or shared by the studio (Studio). Picking one loads it." M {"(no saved looks)"}}
 addUserKnob {1 look_name l name}
 addUserKnob {4 save_to l "save to" t "User: ~/.nuke/ezdepthhaze_looks (or \$EZHAZE_USER_LOOKS). Studio: \$EZHAZE_STUDIO_LOOKS, set by your pipeline. The folders are set in python/ezdepthhaze.py." -STARTLINE M {User Studio}}
 addUserKnob {22 save_look l "save look" -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['easy_message']('Saved ' + d\['save_look'](n))\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {6 advanced t "Shows every knob, set to what Easy did, to fine-tune. Turning it off again starts Easy from your tuned values." +STARTLINE}
 addUserKnob {1 easy_base l "easy base" +INVISIBLE}
 addUserKnob {78 cam_world_matrix l "camera matrix" +INVISIBLE n 16}
 cam_world_matrix {{"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 0) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 1) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 2) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 3) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 4) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 5) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 6) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 7) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 8) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 9) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 10) if c is not None else 1\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 11) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 12) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 13) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 14) if c is not None else 0\}]"} {"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['world_matrix'].getValueAt(nuke.frame(), 15) if c is not None else 1\}]"}}
 addUserKnob {7 cam_focal l "camera focal" +INVISIBLE}
 cam_focal {{"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['focal'].getValueAt(nuke.frame()) if c is not None and c.knob('focal') else 35\}]"}}
 addUserKnob {7 cam_haperture l "camera haperture" +INVISIBLE}
 cam_haperture {{"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['haperture'].getValueAt(nuke.frame()) if c is not None and c.knob('haperture') else 36\}]"}}
 addUserKnob {7 cam_vaperture l "camera vaperture" +INVISIBLE}
 cam_vaperture {{"\[python -execlocal \{c = nuke.thisNode().input(1)\nwhile c is not None and not c.knob('world_matrix'):\n    c = c.input(0) if c.inputs() else None\nret = c\['vaperture'].getValueAt(nuke.frame()) if c is not None and c.knob('vaperture') else 20.25\}]"}}
 addUserKnob {1 tool_code l "tool code" +INVISIBLE}
 tool_code 
 addUserKnob {20 ezdepthhaze l Advanced}
 addUserKnob {4 view_output l "view output" t "What the main rgb shows. Every pass is also written to its own layer: plate * haze_transmittance + haze_sun + haze_sky (+ surface_sunlight * T when added) = result." M {"Hazed Plate" "Haze Transmittance" "Haze In-scatter" "Haze Sun" "Haze Sky" "Haze Shadow" "Haze Fog" "Haze Wisps" "Surface Sunlight" "Surface Sun Visibility" "World Position (P)" "Normals (N)"}}
 addUserKnob {26 plate_divider l Plate}
 addUserKnob {4 plate_type l plate t "Camera: a perspective render or plate, with its Camera plugged into the 'camera' input. Lat-long: a 360 lat-long render, such as an environment of the mountains." M {Camera Lat-long}}
 addUserKnob {41 depth_channel l "depth channel" t "Channel holding the depth." T DepthPick.from0}
 addUserKnob {4 depth_type l "depth type" t "Distance: distance from the camera (most path tracers' 'distance' AOV). Planar Z: depth along the camera's view axis (Arnold/V-Ray Z). 1/Z: Nuke's ScanlineRender." M {Distance "Planar Z" 1/Z}}
 addUserKnob {7 depth_scale l "units to metres" t "Scene units to metres, e.g. 0.01 for centimetres. Scales the depth and the camera position." R 0.001 100}
 depth_scale 1
 addUserKnob {7 latlong_camera_height l "camera height (m)" t "Camera height above sea level for lat-long plates. Camera plates use the camera's height." R 0 5000}
 latlong_camera_height 1
 addUserKnob {4 sky_handling l sky t "Pixels with no depth (or beyond 'sky depth') are sky. Leave Sky keeps them as they are; Haze Sky hazes them as if they were 'sky distance' away." M {"Leave Sky" "Haze Sky"}}
 addUserKnob {7 sky_distance l "sky distance (km)" t "Distance used for sky pixels with Haze Sky." R 0 200}
 sky_distance 50
 addUserKnob {7 sky_threshold l "sky depth" t "Depth (in the plate's units) at or beyond which a pixel counts as sky." R 0 1e+07}
 sky_threshold 10000000
 addUserKnob {26 haze_divider l Haze}
 addUserKnob {6 inherit_atmos l "inherit from atmos" t "With an EzAtmosScatter node in the 'atmos' input, take its haze density, haze height and hdri rotation, so the haze matches its sky." +STARTLINE}
 inherit_atmos true
 addUserKnob {4 haze_color_from l "haze color from" t "Atmos Sun + Sky: EzAtmosScatter's atmos_haze_sun and atmos_haze_sky layers, looked up in each pixel's view direction; shadows remove only the sun part. Atmos Layer: one layer of the atmos input ('atmos layer'), split by 'sun share'. Color: one flat colour, split by 'sun share'." M {"Atmos Sun + Sky" "Atmos Layer" Color}}
 addUserKnob {7 sun_share l "sun share" t "With Atmos Layer or Color: how much of the haze light comes from the sun (and so can be shadowed) rather than the sky."}
 sun_share 0.6
 addUserKnob {6 match_horizon l "match horizon sky" t "With an EzAtmosScatter atmos input, haze far away takes the light of that atmosphere's own sky (its atmos_inscatter over 1 - atmos_transmittance) instead of the light at camera height. At sunset the air far away gets dimmer, redder sunlight, so without this distant terrain fades to a haze brighter than the sky behind it." +STARTLINE}
 match_horizon true
 addUserKnob {7 match_distance l "match distance (km)" t "Distance over which the haze light changes from the camera's to the horizon sky's." R 1 200}
 match_distance 20
 addUserKnob {41 atmos_layer l "atmos layer" t "Layer of the atmos input to use: atmos_haze_color for EzAtmosScatter, rgba for a plain lat-long." T AtmosPick.in1}
 addUserKnob {18 haze_color l "haze color" t "Haze colour when 'haze color from' is Color, or no atmos input is connected."}
 haze_color {0.6 0.65 0.75}
 addUserKnob {7 haze_color_gain l "haze brightness" t "Multiplies the haze colour." R 0 4}
 haze_color_gain 1
 addUserKnob {18 haze_tint l "haze tint" t "Tints all the haze light, e.g. warm brown for smoke. White leaves it as the atmosphere made it."}
 haze_tint {1 1 1}
 addUserKnob {18 haze_density l "haze density (1/m)" t "How much the haze dims light per metre at camera height. Ignored when inheriting."}
 haze_density {0.0001 0.0001 0.0001}
 addUserKnob {7 haze_amount l "haze amount" t "Multiplies the haze density." R 0 10}
 haze_amount 1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins by about two thirds. Ignored when inheriting." R 0.05 10}
 haze_height 1.2
 addUserKnob {7 haze_start l "haze start (m)" t "Distance from the camera where the haze begins." R 0 10000}
 addUserKnob {7 max_distance l "max distance (km)" t "Caps the hazed distance. 0 = no cap." R 0 200}
 addUserKnob {7 env_rotation l "atmos rotation" t "Rotation of the atmos lat-long in degrees. Ignored when inheriting." R -180 180}
 addUserKnob {26 volume_divider l "Fog and Noise"}
 addUserKnob {4 haze_mode l mode t "Fast: the haze alone, worked out exactly in one step. Volumetric: marches each ray so the fog layer and noise below can change the density along it." M {Fast Volumetric}}
 addUserKnob {4 steps l quality t "Samples along each ray in Volumetric mode." M {"Draft (16)" "Normal (48)" "High (96)"}}
 steps "Normal (48)"
 addUserKnob {7 fog_density l "fog density (1/km)" t "How thick the fog layer is. 1 dims light by about two thirds every kilometre." R 0 5}
 addUserKnob {7 fog_top l "fog top (m)" t "Altitude the fog fills up to, e.g. the valley floor plus a few hundred metres." R -500 5000}
 fog_top 1000
 addUserKnob {7 fog_softness l "fog softness (m)" t "How gradually the fog fades out around its top." R 0 2000}
 fog_softness 300
 addUserKnob {7 noise_amount l "noise amount" t "How much world-space noise breaks up the fog."}
 addUserKnob {7 noise_on_haze l "noise on haze" t "How much of the noise also applies to the thin haze, not only the fog."}
 noise_on_haze 0.3
 addUserKnob {7 noise_size l "noise size (m)" t "Size of the largest wisps and banks." R 10 20000}
 noise_size 2000
 addUserKnob {7 noise_stretch l "noise flatten" t "Squashes the noise vertically so it forms banks and layers rather than blobs." R 1 10}
 noise_stretch 3
 addUserKnob {3 noise_detail l "noise detail" t "Octaves of noise: more adds finer wisps."}
 noise_detail 4
 addUserKnob {7 noise_roughness l "noise roughness" t "How strong the finer layers are: higher gives grainier, more detailed noise." R 0.3 0.8}
 noise_roughness 0.5
 addUserKnob {7 noise_sharpness l "noise sharpness" t "Steepens the noise: 1 is soft blobs, higher gives patches with crisp edges." R 1 6}
 noise_sharpness 1
 addUserKnob {13 noise_wind l "wind (m/s)" t "Drifts the noise over time."}
 noise_wind {5 0 0}
 addUserKnob {7 noise_seed l "noise seed" t "Changes the noise pattern." R 0 100}
 noise_seed 1
 addUserKnob {26 shadow_divider l "Sun and Shadows"}
 addUserKnob {13 sun_direction l "sun direction" t "Direction towards the sun, +Y up. Taken from the atmos input's sun direction when inheriting (set its 'sun from' to Manual so the two agree)."}
 sun_direction {0 0.1 -1}
 addUserKnob {7 sun_scatter l "sun scatter" t "Multiplies the sunlit haze: how bright the light shafts are." R 0 4}
 sun_scatter 1
 addUserKnob {7 sky_scatter l "sky scatter" t "Multiplies the sky-lit haze: how bright the haze in shadow is." R 0 4}
 sky_scatter 1
 addUserKnob {7 shadow_strength l "shadow strength" t "How much sunlight the haze loses where the terrain blocks the sun. 1 is physical; 0 turns volumetric shadows off."}
 shadow_strength 1
 addUserKnob {18 shadow_fill l "shadow fill" t "Puts back a tinted share of the sunlight the shadowed haze lost. 0 is physical."}
 shadow_fill {0 0 0}
 addUserKnob {7 shadow_distance l "shadow distance (km)" t "How far towards the sun each point looks for terrain that blocks it." R 0.1 100}
 shadow_distance 20
 addUserKnob {7 penumbra l "penumbra (deg)" t "Softness of the shadow edges: the sun's apparent size is about 0.5. Larger is softer but grainier." R 0 5}
 penumbra 0.5
 addUserKnob {7 occluder_thickness l "occluder thickness (m)" t "How deep each surface in the depth is taken to be. Mountains are solid (the default); lower it for thin objects like trees." R 1 1e+09}
 occluder_thickness 1000000000
 addUserKnob {4 shadow_quality l "shadow quality" t "Samples towards the sun (8, 16, 32) and how often along the view ray they are taken." M {Draft Normal High}}
 shadow_quality Normal
 addUserKnob {26 shadow_note l "" +STARTLINE T "Screen space: only terrain in frame casts shadows. Shadows need Volumetric mode or match horizon sky to step the ray; Fast mode steps 16 slabs."}
 addUserKnob {26 surface_divider l "Surface Light"}
 addUserKnob {6 surface_add l "add surface light" t "Adds the sunlight falling on the terrain to the plate. Off: it is only written to the surface_sunlight layer. Leave off for CG already lit by the same sun." +STARTLINE}
 addUserKnob {7 surface_strength l "surface light strength" t "Multiplies the surface light." R 0 10}
 surface_strength 1
 addUserKnob {18 surface_color l "sun light color" t "Colour and brightness of the sunlight on the terrain."}
 surface_color {1 0.8 0.6}
 addUserKnob {4 albedo_from l "albedo from" t "Plate: use the plate's own colour as the surface colour. Constant: use 'albedo'." M {Plate Constant}}
 addUserKnob {18 albedo}
 albedo {0.15 0.15 0.15}
}
 Input {
  inputs 0
  name camera
  xpos 300
  ypos -300
  number 1
 }
 Input {
  inputs 0
  name plate
  xpos 0
  ypos -300
 }
set N3e724000 [stack 0]
 Input {
  inputs 0
  name atmos
  xpos 600
  ypos -300
  number 2
 }
set N3e724800 [stack 0]
add_layer {atmos_inscatter atmos_inscatter.red atmos_inscatter.green atmos_inscatter.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_inscatter
  fromInput2 {{0} B}
  mappings "4 atmos_inscatter.red 0 0 rgba.red 0 0 atmos_inscatter.green 0 1 rgba.green 0 1 atmos_inscatter.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosSkyScatter
  xpos 750
  ypos -200
 }
push $N3e724800
add_layer {atmos_transmittance atmos_transmittance.red atmos_transmittance.green atmos_transmittance.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_transmittance
  fromInput2 {{0} B}
  mappings "4 atmos_transmittance.red 0 0 rgba.red 0 0 atmos_transmittance.green 0 1 rgba.green 0 1 atmos_transmittance.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosSkyTransmittance
  xpos 900
  ypos -200
 }
 Expression {
  expr0 "max(1 - r, 0.02)"
  expr1 "max(1 - g, 0.02)"
  expr2 "max(1 - b, 0.02)"
  name AtmosSkyVeil
  xpos 900
  ypos -160
 }
 Merge2 {
  inputs 2
  operation divide
  output rgb
  name AtmosSkyPerHaze
  xpos 750
  ypos -120
 }
push $N3e724800
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_haze_color
  fromInput2 {{0} B}
  mappings "4 atmos_haze_color.red 0 0 rgba.red 0 0 atmos_haze_color.green 0 1 rgba.green 0 1 atmos_haze_color.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosPick
  xpos 600
  ypos -200
 }
set N3e725000 [stack 0]
 Multiply {
  channels rgb
  value {{"1 - parent.sun_share"}}
  name LayerSkyShare
  xpos 650
  ypos -170
 }
push $N3e724800
add_layer {atmos_haze_sky atmos_haze_sky.red atmos_haze_sky.green atmos_haze_sky.blue}
 Shuffle2 {
  fromInput1 {{0} B}
  in1 atmos_haze_sky
