  in1 atmos_transmittance
  fromInput2 {{0} B}
  mappings "4 atmos_transmittance.red 0 0 rgba.red 0 0 atmos_transmittance.green 0 1 rgba.green 0 1 atmos_transmittance.blue 0 2 rgba.blue 0 2 black -1 -1 rgba.alpha 0 3"
  name AtmosSkyTransmittance
  xpos 900
  ypos -200
 }
