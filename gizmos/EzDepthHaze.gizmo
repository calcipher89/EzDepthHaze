Gizmo {
 name EzDepthHaze1
 knobChanged "k = nuke.thisKnob().name()\nn = nuke.thisNode()\nif k == 'showPanel' and n.knob('tool_code'):\n    _ezd = \{\}\n    exec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), _ezd)\n    _ezd\['refresh_look_menu'](n)\nelif k in \['preset', 'look_strength', 'easy_haze', 'easy_warmth', 'easy_glow', 'easy_shafts', 'easy_light', 'easy_shadow', 'easy_fog', 'easy_fog_height', 'easy_fog_softness', 'easy_texture', 'easy_texture_scale', 'easy_texture_detail', 'easy_texture_sharpness', 'vis_near', 'vis_far', 'vis_fog', 'sky_handling', 'sky_distance', 'haze_color_from', 'sun_share', 'match_horizon', 'match_distance', 'haze_color', 'haze_color_gain', 'haze_tint', 'haze_density', 'haze_amount', 'haze_height', 'haze_start', 'max_distance', 'env_rotation', 'haze_mode', 'steps', 'fog_density', 'fog_top', 'fog_softness', 'noise_amount', 'noise_on_haze', 'noise_size', 'noise_stretch', 'noise_detail', 'noise_roughness', 'noise_sharpness', 'noise_wind', 'noise_seed', 'sun_direction', 'sun_scatter', 'sky_scatter', 'shadow_strength', 'shadow_fill', 'shadow_distance', 'penumbra', 'occluder_thickness', 'shadow_quality', 'surface_add', 'surface_strength', 'surface_color', 'albedo_from', 'albedo'] and nuke.GUI and n.shown() and not getattr(nuke, '_ezhaze_busy', False):\n    _ezd = \{\}\n    exec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), _ezd)\n    _ezd\['on_knob'](n, k)\n"
 tile_color 0x6a8fa5ff
 selected true
 addUserKnob {20 easy l Easy}
 addUserKnob {26 looks_divider l Look}
 addUserKnob {4 preset l look t "A starting look, applied as soon as you pick it and fitted to this shot: the depth and camera are measured at this frame and haze amount, fog height, noise and distances are scaled to match the demo the presets were tuned on. Afterwards it offers to move the EzAtmosScatter sun to where the look wants it:\nClear Day: sun high, 30-45 degrees, from the side; white, full strength.\nGolden Hour: sun low, 2-6 degrees, in front of the camera; warm.\nValley Fog: sun low morning sun, 8-15 degrees; slightly warm.\nSmoke Haze: sun any; a dimmed, reddened sun reads best.\nOvercast Mist: sun any; it hardly shows." M {"Clear Day" "Golden Hour" "Valley Fog" "Smoke Haze" "Overcast Mist"}}
 preset "Golden Hour"
 addUserKnob {22 apply_preset l apply t "Applies the look again, fitted to the shot: e.g. after connecting the plate and camera, or to start over." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['apply_look'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {22 analyze t "Checks the inputs and sets up the plate: units to metres from the EzAtmosScatter in 'atmos', 1/Z depth, and a sky dome or card behind the terrain. Warns about a missing camera or a sun beside or behind it." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['analyze'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {22 reset_look l "reset look" t "Puts every look knob back to the node's defaults and centres the sliders. The plate settings (depth channel, type, units) are kept." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['reset_look'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {22 layer_breakout l "layer breakout" t "Builds the result from this node's layers next to it, one Shuffle and Merge per layer: plate (+ surface_sunlight) x haze_transmittance + haze_sun + haze_sky, with a difference check at the bottom that should be black." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['build_breakout'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {4 view_output l "view output" t "What the main rgb shows. Every pass is also written to its own layer: plate * haze_transmittance + haze_sun + haze_sky (+ surface_sunlight * T when added) = result." M {"Hazed Plate" "Haze Transmittance" "Haze In-scatter" "Haze Sun" "Haze Sky" "Haze Shadow" "Haze Fog" "Haze Wisps" "Surface Sunlight" "Surface Sun Visibility" "World Position (P)" "Normals (N)"}}
 addUserKnob {4 viewer_resolution l "viewer resolution" t "Size the haze is computed at in the Nuke GUI, then scaled back up: Half uses about a quarter of the GPU memory and time. Renders from a terminal (the farm) are always Full." -STARTLINE M {Full Half Quarter}}
 viewer_resolution Half
 addUserKnob {4 clip_to l "clip to" t "Crops the output to the plate's format, to the plate's bounding box, or not at all." M {format bbox "no clip"}}
 addUserKnob {7 smooth l "smooth grain (px)" t "Averages away the sampling grain in the haze layers, but only between pixels at about the same depth, so ridge lines stay sharp. 0 is off; 2 cleans most grain; raise steps and shadow quality as well for finals." R 0 6}
 smooth 2
 addUserKnob {6 blue_noise l "blue noise" t "Spreads the sampling evenly from pixel to pixel, so the leftover grain is finer and less visible. Off: plain random sampling, as in earlier versions." -STARTLINE}
 blue_noise true
 addUserKnob {4 edge_antialias l "edge antialias" t "Blends the haze across depth edges (ridge lines, silhouettes) over 1 to 3 pixels, like a small 3x3 blur at the edges only, so the grain and stair-stepping along them goes away." M {Off 1x 2x 3x}}
 edge_antialias 1x
 addUserKnob {7 look_strength l "look strength" t "From clear air (0) to the full look (1)."}
 look_strength 1
 addUserKnob {26 vis_divider l Visibility}
 addUserKnob {7 vis_near l "haze clear to (km)" t "Air nearer than this stays clear: the haze starts here." R 0 20}
 addUserKnob {7 vis_far l "haze fades by (km)" t "Distance at which terrain has faded into the haze (5% left). Lower is thicker haze." R 0.5 200}
 addUserKnob {7 vis_fog l "fog fades by (km)" t "Distance through the fog at which terrain has faded into it. 0 = no fog." R 0.05 50}
 addUserKnob {7 silhouette t "Bends how the haze builds with distance: near terrain keeps its contrast and the far ranges close in faster, turning into flat layers the colour of the sky. 0 is the plain haze. Adds no lift to the foreground, unlike more haze."}
 addUserKnob {26 adjust_divider l Adjust}
 addUserKnob {7 easy_haze l haze t "How thick the haze is." R 0 3}
 easy_haze 1
 addUserKnob {7 easy_warmth l warmth t "Cooler (blue) to warmer (orange) haze light." R -1 1}
 addUserKnob {7 easy_glow l glow t "How bright the sunlit haze is, around and towards the sun." R 0 3}
 easy_glow 1
 addUserKnob {7 easy_shafts l shafts t "How strongly the terrain shadows the haze: 0 is no shafts." R 0 2}
 easy_shafts 1
 addUserKnob {7 easy_light l light t "Sunlight falling on the terrain itself (surface light): 0 is none, past 1 adds it to looks without it. Leave at 0 for CG already lit by the same sun." R 0 3}
 easy_light 1
 addUserKnob {7 easy_shadow l shadow t "How dark the shadowed haze is: lower fills the shadows with light, higher deepens them." R 0 2}
 easy_shadow 1
 addUserKnob {7 easy_fog l fog t "How dense the valley fog is." R 0 3}
 easy_fog 1
 addUserKnob {7 easy_fog_height l "fog height" t "Lower or raise the fog, in steps of the terrain's height range. Low and negative for low-lying fog in the valley floors." R -1 1}
 addUserKnob {7 easy_fog_softness l "fog softness" t "How gradually the fog fades out at its top: low gives a crisp fog bank, high a soft mist." R 0.1 3}
 easy_fog_softness 1
 addUserKnob {7 easy_texture l texture t "How much the noise breaks up the haze and fog." R 0 3}
 easy_texture 1
 addUserKnob {7 easy_texture_scale l "texture scale" t "Size of the noise patches: lower gives smaller, busier patches." R 0.2 3}
 easy_texture_scale 1
 addUserKnob {7 easy_texture_detail l "texture detail" t "Fine detail in the noise: more layers of smaller wisps on the big shapes." R 0 2}
 easy_texture_detail 1
 addUserKnob {7 easy_texture_sharpness l "texture sharpness" t "Soft blobs (0) to patches with crisp edges (2)." R 0 2}
 addUserKnob {22 surprise_me l "surprise me" t "Random adjustments within tasteful limits; 'surprise strength' sets how far they go." T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['surprise'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n" +STARTLINE}
 addUserKnob {7 surprise_strength l "surprise strength" t "How far 'surprise me' moves the sliders from the middle: 0.5 for small nudges, 1 for the usual range, 2 for wild." -STARTLINE R 0 2}
 surprise_strength 1
 addUserKnob {22 reset_easy l "centre sliders" t "Centres the sliders, back to the look as applied." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['reset_sliders'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {26 save_divider l "My Looks"}
 addUserKnob {4 my_looks l "saved looks" t "Looks saved by you (User) or shared by the studio (Studio). Press 'apply look' to use one." M {"(no saved looks)"}}
 addUserKnob {22 load_look l "apply look" t "Applies the saved look picked in the menu." -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['load_look'](n)\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
 addUserKnob {1 look_name l name}
 addUserKnob {4 save_to l "save to" t "User or Studio looks folder; both are in the hidden 'user looks folder' and 'studio looks folder' knobs, which a pipeline can set (an environment variable wins when set)." -STARTLINE M {User Studio}}
 addUserKnob {22 save_look l "save look" -STARTLINE T "n = nuke.thisNode()\nd = \{\}\nexec(__import__('base64').b64decode(n\['tool_code'].value()).decode(), d)\ntry:\n    d\['easy_message']('Saved ' + d\['save_look'](n))\nexcept ValueError as e:\n    d\['easy_message'](str(e))\n"}
