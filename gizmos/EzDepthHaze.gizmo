  EzDepthHaze_haze_density {{"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.r : parent.haze_density.r"} {"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.g : parent.haze_density.g"} {"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.b : parent.haze_density.b"}}
  EzDepthHaze_haze_amount {{parent.haze_amount}}
  EzDepthHaze_haze_height {{"(parent.inherit_atmos && \[exists parent.input2.haze_height] ? parent.input2.haze_height : parent.haze_height) * 1000"}}
  EzDepthHaze_haze_start {{parent.haze_start}}
  EzDepthHaze_max_distance {{"parent.max_distance * 1000"}}
  EzDepthHaze_volumetric {{parent.haze_mode}}
  EzDepthHaze_march_steps {{"parent.steps==0 ? 16 : parent.steps==1 ? 48 : 96"}}
  EzDepthHaze_fog_density {{"parent.fog_density / 1000"}}
  EzDepthHaze_fog_top {{parent.fog_top}}
  EzDepthHaze_fog_softness {{parent.fog_softness}}
  EzDepthHaze_noise_amount {{parent.noise_amount}}
  EzDepthHaze_noise_on_haze {{parent.noise_on_haze}}
  EzDepthHaze_noise_size {{parent.noise_size}}
  EzDepthHaze_noise_stretch {{parent.noise_stretch}}
  EzDepthHaze_noise_detail {{parent.noise_detail}}
  EzDepthHaze_noise_wind {{parent.noise_wind.x} {parent.noise_wind.y} {parent.noise_wind.z}}
  EzDepthHaze_noise_time {{"frame / root.fps"}}
  EzDepthHaze_noise_seed {{parent.noise_seed}}
  EzDepthHaze_sun_direction {{"parent.inherit_atmos && \[exists parent.input2.sun_direction] ? parent.input2.sun_direction.x : parent.sun_direction.x"} {"parent.inherit_atmos && \[exists parent.input2.sun_direction] ? parent.input2.sun_direction.y : parent.sun_direction.y"} {"parent.inherit_atmos && \[exists parent.input2.sun_direction] ? parent.input2.sun_direction.z : parent.sun_direction.z"}}
  EzDepthHaze_use_far {{"\[exists parent.input2] && parent.match_horizon"}}
  EzDepthHaze_match_distance {{"parent.match_distance * 1000"}}
  EzDepthHaze_sun_scatter {{parent.sun_scatter}}
  EzDepthHaze_sky_scatter {{parent.sky_scatter}}
  EzDepthHaze_shadow_strength {{parent.shadow_strength}}
  EzDepthHaze_shadow_fill {{parent.shadow_fill.r} {parent.shadow_fill.g} {parent.shadow_fill.b}}
  EzDepthHaze_shadow_distance {{"parent.shadow_distance * 1000"}}
  EzDepthHaze_penumbra {{parent.penumbra}}
  EzDepthHaze_shadow_samples {{"parent.shadow_quality==0 ? 8 : parent.shadow_quality==1 ? 16 : 32"}}
  EzDepthHaze_shadow_every {{"parent.shadow_quality==0 ? 6 : parent.shadow_quality==1 ? 3 : 1"}}
  EzDepthHaze_occluder_thickness {{parent.occluder_thickness}}
  EzDepthHaze_surface_color {{parent.surface_color.r} {parent.surface_color.g} {parent.surface_color.b}}
  EzDepthHaze_surface_strength {{parent.surface_strength}}
  EzDepthHaze_albedo_from_plate {{parent.albedo_from==0}}
  EzDepthHaze_albedo {{parent.albedo.r} {parent.albedo.g} {parent.albedo.b}}
  rebuild_finalise ""
  name Pass_transmittance
  xpos -300
  ypos -80
 }
