version 15.1 v3
add_layer {haze_transmittance haze_transmittance.red haze_transmittance.green haze_transmittance.blue}
add_layer {haze_inscatter haze_inscatter.red haze_inscatter.green haze_inscatter.blue}
Gizmo {
 name EzDepthHaze1
 tile_color 0x6a8fa5ff
 selected true
 addUserKnob {20 ezdepthhaze l EzDepthHaze}
 addUserKnob {4 view_output l "view output" t "What the main rgb shows. The transmittance and in-scatter are also written to the haze_transmittance and haze_inscatter layers." M {"Hazed Plate" "Haze Transmittance" "Haze In-scatter"}}
 addUserKnob {26 plate_divider l Plate}
 addUserKnob {4 plate_type l plate t "Camera: a perspective render or plate, with its Camera plugged into the 'camera' input. Lat-long: a 360 lat-long render, such as an environment of the mountains." M {Camera Lat-long}}
 addUserKnob {41 depth_channel l "depth channel" t "Channel holding the depth." T DepthPick.from0}
 addUserKnob {4 depth_type l "depth type" t "Distance: distance from the camera (most path tracers' 'distance' AOV). Planar Z: depth along the camera's view axis (Arnold/V-Ray Z). 1/Z: Nuke's ScanlineRender." M {Distance "Planar Z" 1/Z}}
 addUserKnob {7 depth_scale l "units to metres" t "Multiplies depth to get metres, e.g. 0.01 for centimetres." R 0.001 100}
 depth_scale 1
 addUserKnob {7 latlong_camera_height l "camera height (m)" t "Camera height above sea level for lat-long plates. Camera plates use the camera's height." R 0 5000}
 latlong_camera_height 1
 addUserKnob {4 sky_handling l sky t "Pixels with no depth (or beyond 'sky depth') are sky. Leave Sky keeps them as they are; Haze Sky hazes them as if they were 'sky distance' away." M {"Leave Sky" "Haze Sky"}}
 addUserKnob {7 sky_distance l "sky distance (km)" t "Distance used for sky pixels with Haze Sky." R 0 200}
 sky_distance 50
 addUserKnob {7 sky_threshold l "sky depth" t "Depth (in the plate's units) at or beyond which a pixel counts as sky." R 0 1e+07}
 sky_threshold 10000000
 addUserKnob {26 haze_divider l Haze}
 addUserKnob {6 inherit_atmos l "inherit from atmos" t "With an EzAtmosScatter node in the 'atmos' input, take its haze density, haze height and hdri rotation, so the haze matches its sky." +STARTLINE}
 inherit_atmos true
 addUserKnob {4 haze_color_from l "haze color from" t "Atmos Input: the colour comes from the lat-long in the 'atmos' input, looked up in each pixel's view direction, so the sun side glows. Color: one flat colour." M {"Atmos Input" Color}}
 addUserKnob {41 atmos_layer l "atmos layer" t "Layer of the atmos input to use: atmos_haze_color for EzAtmosScatter, rgba for a plain lat-long." T AtmosPick.in1}
 addUserKnob {18 haze_color l "haze color" t "Haze colour when 'haze color from' is Color, or no atmos input is connected."}
 haze_color {0.6 0.65 0.75}
 addUserKnob {7 haze_color_gain l "haze brightness" t "Multiplies the haze colour." R 0 4}
 haze_color_gain 1
 addUserKnob {18 haze_density l "haze density (1/m)" t "How much the haze dims light per metre at camera height. Ignored when inheriting."}
 haze_density {0.0001 0.0001 0.0001}
 addUserKnob {7 haze_amount l "haze amount" t "Multiplies the haze density." R 0 10}
 haze_amount 1
 addUserKnob {7 haze_height l "haze height (km)" t "Height over which the haze thins by about two thirds. Ignored when inheriting." R 0.05 10}
 haze_height 1.2
 addUserKnob {7 haze_start l "haze start (m)" t "Distance from the camera where the haze begins." R 0 10000}
 addUserKnob {7 max_distance l "max distance (km)" t "Caps the hazed distance. 0 = no cap." R 0 200}
 addUserKnob {7 env_rotation l "atmos rotation" t "Rotation of the atmos lat-long in degrees. Ignored when inheriting." R -180 180}
 addUserKnob {26 volume_divider l "Fog and Noise"}
 addUserKnob {4 haze_mode l mode t "Fast: the haze alone, worked out exactly in one step. Volumetric: marches each ray so the fog layer and noise below can change the density along it." M {Fast Volumetric}}
 addUserKnob {4 steps l quality t "Samples along each ray in Volumetric mode." M {"Draft (16)" "Normal (48)" "High (96)"}}
 steps "Normal (48)"
 addUserKnob {7 fog_density l "fog density (1/km)" t "How thick the fog layer is. 1 dims light by about two thirds every kilometre." R 0 5}
 addUserKnob {7 fog_top l "fog top (m)" t "Altitude the fog fills up to, e.g. the valley floor plus a few hundred metres." R -500 5000}
 fog_top 1000
 addUserKnob {7 fog_softness l "fog softness (m)" t "How gradually the fog fades out around its top." R 0 2000}
 fog_softness 300
 addUserKnob {7 noise_amount l "noise amount" t "How much world-space noise breaks up the fog."}
 addUserKnob {7 noise_on_haze l "noise on haze" t "How much of the noise also applies to the thin haze, not only the fog."}
 noise_on_haze 0.3
 addUserKnob {7 noise_size l "noise size (m)" t "Size of the largest wisps and banks." R 10 20000}
 noise_size 2000
 addUserKnob {7 noise_stretch l "noise flatten" t "Squashes the noise vertically so it forms banks and layers rather than blobs." R 1 10}
 noise_stretch 3
 addUserKnob {3 noise_detail l "noise detail" t "Octaves of noise: more adds finer wisps."}
 noise_detail 4
 addUserKnob {13 noise_wind l "wind (m/s)" t "Drifts the noise over time."}
 noise_wind {5 0 0}
 addUserKnob {7 noise_seed l "noise seed" t "Changes the noise pattern." R 0 100}
 noise_seed 1
}
 Input {
  inputs 0
  name camera
  xpos 300
  ypos -300
  number 1
 }
 Input {
  inputs 0
  name atmos
  xpos 600
  ypos -300
  number 2
 }
 Shuffle2 {
  fromInput1 {{0} B}
  in1 none
  fromInput2 {{0} B}
  name AtmosPick
  xpos 600
  ypos -200
 }
set N65b45000 [stack 0]
 Input {
  inputs 0
  name plate
  xpos 0
  ypos -300
 }
set N65b44000 [stack 0]
push $N65b44000
 Copy {
  inputs 2
  from0 depth.Z
  to0 rgba.red
  name DepthPick
  xpos 150
  ypos -200
 }
set N65b44c00 [stack 0]
push $N65b44000
 BlinkScript {
  inputs 3
  recompileCount 2
  KernelDescription "3 \"EzDepthHaze\" iterate pixelWise e7a42ae3415946d143b345c43ce985df95547a56bd3f4f1e938e6442fa1bf272 4 \"plate\" Read Point \"depth\" Read Point \"env\" Read Random \"dst\" Write Point 37 \"output\" Int 1 AAAAAA== \"latlong_plate\" Int 1 AAAAAA== \"cam_row0\" Float 3 AACAPwAAAAAAAAAAAAAAAA== \"cam_row1\" Float 3 AAAAAAAAgD8AAAAAAAAAAA== \"cam_row2\" Float 3 AAAAAAAAAAAAAIA/AAAAAA== \"cam_position\" Float 3 AAAAAAAAAAAAAAAAAAAAAA== \"focal\" Float 1 AAAMQg== \"haperture\" Float 1 AAAQQg== \"vaperture\" Float 1 AACiQQ== \"latlong_camera_height\" Float 1 AACAPw== \"depth_type\" Int 1 AAAAAA== \"depth_scale\" Float 1 AACAPw== \"sky_threshold\" Float 1 gJYYSw== \"haze_sky\" Int 1 AAAAAA== \"sky_distance\" Float 1 AFBDRw== \"use_env\" Int 1 AQAAAA== \"env_rotation\" Float 1 AAAAAA== \"haze_color\" Float 3 mpkZP2ZmJj8AAEA/AAAAAA== \"haze_color_gain\" Float 1 AACAPw== \"haze_density\" Float 3 F7fROBe30TgXt9E4AAAAAA== \"haze_amount\" Float 1 AACAPw== \"haze_height\" Float 1 AACWRA== \"haze_start\" Float 1 AAAAAA== \"max_distance\" Float 1 AAAAAA== \"volumetric\" Int 1 AAAAAA== \"march_steps\" Int 1 MAAAAA== \"fog_density\" Float 1 AAAAAA== \"fog_top\" Float 1 AAB6RA== \"fog_softness\" Float 1 AACWQw== \"noise_amount\" Float 1 AAAAAA== \"noise_on_haze\" Float 1 mpmZPg== \"noise_size\" Float 1 AAD6RA== \"noise_stretch\" Float 1 AABAQA== \"noise_detail\" Int 1 BAAAAA== \"noise_wind\" Float 3 AACgQAAAAAAAAAAAAAAAAA== \"noise_time\" Float 1 AAAAAA== \"noise_seed\" Float 1 AACAPw== 37 \"output\" 1 1 Default \"latlongPlate\" 1 1 Default \"camRow0\" 3 1 Default \"camRow1\" 3 1 Default \"camRow2\" 3 1 Default \"camPosition\" 3 1 Default \"focal\" 1 1 Default \"haperture\" 1 1 Default \"vaperture\" 1 1 Default \"latlongCameraHeight\" 1 1 Default \"depthType\" 1 1 Default \"depthScale\" 1 1 Default \"skyThreshold\" 1 1 Default \"hazeSky\" 1 1 Default \"skyDistance\" 1 1 Default \"useEnv\" 1 1 Default \"envRotation\" 1 1 Default \"hazeColor\" 3 1 Default \"hazeColorGain\" 1 1 Default \"hazeDensity\" 3 1 Default \"hazeAmount\" 1 1 Default \"hazeHeight\" 1 1 Default \"hazeStart\" 1 1 Default \"maxDistance\" 1 1 Default \"volumetric\" 1 1 Default \"marchSteps\" 1 1 Default \"fogDensity\" 1 1 Default \"fogTop\" 1 1 Default \"fogSoftness\" 1 1 Default \"noiseAmount\" 1 1 Default \"noiseOnHaze\" 1 1 Default \"noiseSize\" 1 1 Default \"noiseStretch\" 1 1 Default \"noiseDetail\" 1 1 Default \"noiseWind\" 3 1 Default \"noiseTime\" 1 1 Default \"noiseSeed\" 1 1 Default 1 \"pi\" Float 1 1 AAAAAA=="
  kernelSource "// EzDepthHaze: hazes a plate with its depth, lit like EzAtmosScatter's haze.\n//\n// For every pixel the kernel finds the view direction (from the camera, or from the\n// lat-long position), converts its depth to metres, and works out how much haze lies\n// between the camera and the surface. The haze thins exponentially with altitude, so\n// looking up clears faster than looking sideways:\n//\n//   tau    = density * H / c * (exp(-c * s / H) - exp(-c * d / H)),  c = dir.y\n//   T      = exp(-tau)\n//   result = plate * T + hazeColor(dir) * (1 - T)\n//\n// where s is where the haze starts along the ray, d the surface distance and H the haze\n// height. hazeColor is the colour infinitely deep haze has in that direction: the `env`\n// input (EzAtmosScatter's atmos_haze_color lat-long) or a flat colour.\n//\n// With `volumetric` on, the ray is marched instead so the density can vary along it: the\n// same haze, plus a fog layer that fills everything below fogTop and fades out over\n// fogSoftness above it, all modulated by 3D fBm noise fixed in world space (it drifts\n// with noiseWind over noiseTime, so it stays put when the camera moves).\n//\n// Inputs: `plate` rgba, `depth` with the depth in red, `env` a lat-long in the\n// EzAtmosScatter convention (centre column looks down -Z, top row up).\n// Distances are in metres, +Y is up.\n//\n// output: 0 = hazed plate, 1 = haze transmittance, 2 = haze in-scatter\n\nkernel EzDepthHaze : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> plate;\n  Image<eRead, eAccessPoint, eEdgeClamped> depth;\n  Image<eRead, eAccessRandom, eEdgeClamped> env;\n  Image<eWrite> dst;\n\nparam:\n  int output;\n  int latlongPlate;\n  float3 camRow0;\n  float3 camRow1;\n  float3 camRow2;\n  float3 camPosition;\n  float focal;\n  float haperture;\n  float vaperture;\n  float latlongCameraHeight;\n  int depthType;\n  float depthScale;\n  float skyThreshold;\n  int hazeSky;\n  float skyDistance;\n  int useEnv;\n  float envRotation;\n  float3 hazeColor;\n  float hazeColorGain;\n  float3 hazeDensity;\n  float hazeAmount;\n  float hazeHeight;\n  float hazeStart;\n  float maxDistance;\n  int volumetric;\n  int marchSteps;\n  float fogDensity;\n  float fogTop;\n  float fogSoftness;\n  float noiseAmount;\n  float noiseOnHaze;\n  float noiseSize;\n  float noiseStretch;\n  int noiseDetail;\n  float3 noiseWind;\n  float noiseTime;\n  float noiseSeed;\n\nlocal:\n  float pi;\n\n  void define()\n  \{\n    defineParam(output, \"output\", 0);\n    defineParam(latlongPlate, \"latlong_plate\", 0);\n    defineParam(camRow0, \"cam_row0\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(camRow1, \"cam_row1\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(camRow2, \"cam_row2\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(camPosition, \"cam_position\", float3(0.0f, 0.0f, 0.0f));\n    defineParam(focal, \"focal\", 35.0f);\n    defineParam(haperture, \"haperture\", 36.0f);\n    defineParam(vaperture, \"vaperture\", 20.25f);\n    defineParam(latlongCameraHeight, \"latlong_camera_height\", 1.0f);\n    defineParam(depthType, \"depth_type\", 0);\n    defineParam(depthScale, \"depth_scale\", 1.0f);\n    defineParam(skyThreshold, \"sky_threshold\", 1e7f);\n    defineParam(hazeSky, \"haze_sky\", 0);\n    defineParam(skyDistance, \"sky_distance\", 50000.0f);\n    defineParam(useEnv, \"use_env\", 1);\n    defineParam(envRotation, \"env_rotation\", 0.0f);\n    defineParam(hazeColor, \"haze_color\", float3(0.6f, 0.65f, 0.75f));\n    defineParam(hazeColorGain, \"haze_color_gain\", 1.0f);\n    defineParam(hazeDensity, \"haze_density\", float3(0.0001f, 0.0001f, 0.0001f));\n    defineParam(hazeAmount, \"haze_amount\", 1.0f);\n    defineParam(hazeHeight, \"haze_height\", 1200.0f);\n    defineParam(hazeStart, \"haze_start\", 0.0f);\n    defineParam(maxDistance, \"max_distance\", 0.0f);\n    defineParam(volumetric, \"volumetric\", 0);\n    defineParam(marchSteps, \"march_steps\", 48);\n    defineParam(fogDensity, \"fog_density\", 0.0f);\n    defineParam(fogTop, \"fog_top\", 1000.0f);\n    defineParam(fogSoftness, \"fog_softness\", 300.0f);\n    defineParam(noiseAmount, \"noise_amount\", 0.0f);\n    defineParam(noiseOnHaze, \"noise_on_haze\", 0.3f);\n    defineParam(noiseSize, \"noise_size\", 2000.0f);\n    defineParam(noiseStretch, \"noise_stretch\", 3.0f);\n    defineParam(noiseDetail, \"noise_detail\", 4);\n    defineParam(noiseWind, \"noise_wind\", float3(5.0f, 0.0f, 0.0f));\n    defineParam(noiseTime, \"noise_time\", 0.0f);\n    defineParam(noiseSeed, \"noise_seed\", 1.0f);\n  \}\n\n  void init()\n  \{\n    pi = 3.14159265358979f;\n  \}\n\n  float3 exp3(float3 v)\n  \{\n    return float3(exp(v.x), exp(v.y), exp(v.z));\n  \}\n\n  float3 envLookup(float3 d)\n  \{\n    float lon = atan2(d.x, -d.z) - envRotation * pi / 180.0f;\n    float lat = asin(clamp(d.y, -1.0f, 1.0f));\n    float u = lon / (2.0f * pi) + 0.5f;\n    u = u - floor(u);\n    float v = lat / pi + 0.5f;\n    float x = env.bounds.x1 + u * env.bounds.width() - 0.5f;\n    float y = env.bounds.y1 + v * env.bounds.height() - 0.5f;\n    float4 c = bilinear(env, x, y);\n    return float3(c.x, c.y, c.z);\n  \}\n\n  float hash3(float3 p)\n  \{\n    float h = sin(p.x * 127.1f + p.y * 311.7f + p.z * 74.7f + noiseSeed * 19.3f) * 43758.5453f;\n    return h - floor(h);\n  \}\n\n  float vnoise3(float3 p)\n  \{\n    float ix = floor(p.x), iy = floor(p.y), iz = floor(p.z);\n    float fx = p.x - ix, fy = p.y - iy, fz = p.z - iz;\n    float ux = fx * fx * (3.0f - 2.0f * fx);\n    float uy = fy * fy * (3.0f - 2.0f * fy);\n    float uz = fz * fz * (3.0f - 2.0f * fz);\n    float a = hash3(float3(ix, iy, iz)), b = hash3(float3(ix + 1.0f, iy, iz));\n    float c = hash3(float3(ix, iy + 1.0f, iz)), d = hash3(float3(ix + 1.0f, iy + 1.0f, iz));\n    float e = hash3(float3(ix, iy, iz + 1.0f)), f = hash3(float3(ix + 1.0f, iy, iz + 1.0f));\n    float g = hash3(float3(ix, iy + 1.0f, iz + 1.0f)), h = hash3(float3(ix + 1.0f, iy + 1.0f, iz + 1.0f));\n    float ab = a + (b - a) * ux, cd = c + (d - c) * ux;\n    float ef = e + (f - e) * ux, gh = g + (h - g) * ux;\n    float lo = ab + (cd - ab) * uy, hi = ef + (gh - ef) * uy;\n    return lo + (hi - lo) * uz;\n  \}\n\n  // Density multiplier from world-space fBm: 1 on average, more or less where the noise\n  // is high or low. Squashed vertically so it reads as banks and wisps, not blobs.\n  float noiseFactor(float3 p)\n  \{\n    if (noiseAmount <= 0.0f)\n      return 1.0f;\n    float3 q = (p - noiseWind * noiseTime) / noiseSize;\n    q.y *= noiseStretch;\n    float sum = 0.0f, amp = 0.5f, norm = 0.0f;\n    for (int i = 0; i < noiseDetail; i++) \{\n      sum += amp * vnoise3(q);\n      norm += amp;\n      q = float3(q.x * 2.03f + 1.7f, q.y * 2.03f + 9.2f, q.z * 2.03f + 4.1f);\n      amp *= 0.5f;\n    \}\n    float n = sum / norm;\n    return max(1.0f + noiseAmount * 2.5f * (n - 0.5f), 0.0f);\n  \}\n\n  // Extinction per metre at p: the base haze, thinning with height from the camera, plus\n  // the fog layer, which is full below fogTop and fades out over fogSoftness above it.\n  float3 density(float3 p, float cameraHeight)\n  \{\n    float3 haze = hazeDensity * (hazeAmount * exp(-(p.y - cameraHeight) / hazeHeight));\n    float edge = clamp((p.y - fogTop) / max(fogSoftness, 1.0f) + 0.5f, 0.0f, 1.0f);\n    float fog = fogDensity * (1.0f - edge * edge * (3.0f - 2.0f * edge));\n    float n = noiseFactor(p);\n    return (haze * (1.0f - noiseOnHaze + noiseOnHaze * n)) + float3(fog * n);\n  \}\n\n  // Integral of exp(-c * t / H) for t from s to d: the optical length of the ray\n  // through haze that thins with height.\n  float heightPath(float c, float s, float d)\n  \{\n    if (fabs(c) * (d - s) / hazeHeight < 1e-4f)\n      return (d - s) * exp(-c * s / hazeHeight);\n    return hazeHeight / c * (exp(-c * s / hazeHeight) - exp(-c * d / hazeHeight));\n  \}\n\n  void process(int2 pos)\n  \{\n    float4 src = plate();\n    float rawDepth = depth().x;\n\n    float u = (pos.x - plate.bounds.x1 + 0.5f) / plate.bounds.width();\n    float v = (pos.y - plate.bounds.y1 + 0.5f) / plate.bounds.height();\n    float3 dir;\n    float3 origin;\n    float planarScale = 1.0f;\n    if (latlongPlate != 0) \{\n      float lon = (u - 0.5f) * 2.0f * pi;\n      float lat = (v - 0.5f) * pi;\n      dir = float3(sin(lon) * cos(lat), sin(lat), -cos(lon) * cos(lat));\n      origin = float3(0.0f, latlongCameraHeight, 0.0f);\n    \} else \{\n      float3 camDir = float3((u - 0.5f) * haperture / focal, (v - 0.5f) * vaperture / focal, -1.0f);\n      planarScale = length(camDir);\n      dir = normalize(float3(dot(camRow0, camDir), dot(camRow1, camDir), dot(camRow2, camDir)));\n      origin = camPosition;\n    \}\n\n    // Depth to distance along the ray, in metres.\n    float dist = rawDepth;\n    if (depthType == 1)\n      dist = rawDepth * planarScale;\n    else if (depthType == 2)\n      dist = rawDepth > 0.0f ? planarScale / rawDepth : 0.0f;\n    dist *= depthScale;\n\n    bool sky = rawDepth <= 0.0f || dist >= skyThreshold;\n    if (sky)\n      dist = hazeSky != 0 ? skyDistance : 0.0f;\n    if (maxDistance > 0.0f)\n      dist = min(dist, maxDistance);\n\n    float s = min(hazeStart, dist);\n    float3 light = useEnv != 0 ? envLookup(dir) : hazeColor;\n    light *= hazeColorGain;\n\n    float3 transmittance;\n    float3 inscatter;\n    if (volumetric == 0) \{\n      // Density is given at camera height; heightPath measures from the camera.\n      float path = heightPath(dir.y, s, dist);\n      transmittance = exp3(-hazeDensity * (hazeAmount * path));\n      inscatter = light * (float3(1.0f) - transmittance);\n    \} else \{\n      // March the ray, so the density can change along it: haze thinning with height,\n      // a fog layer below fogTop, and world-space noise. Steps are packed towards the\n      // camera (quadratic spacing) and jittered per pixel to hide banding.\n      float jitter = hash3(float3(pos.x, pos.y, 17.0f));\n      transmittance = float3(1.0f);\n      inscatter = float3(0.0f);\n      float tPrev = s;\n      for (int i = 0; i < marchSteps; i++) \{\n        float f = (i + jitter) / marchSteps;\n        float t = s + (dist - s) * f * f;\n        float dt = t - tPrev;\n        tPrev = t;\n        float3 p = origin + dir * t;\n        float3 sigma = density(p, origin.y) * dt;\n        float3 stepT = exp3(-sigma);\n        inscatter += transmittance * (float3(1.0f) - stepT) * light;\n        transmittance *= stepT;\n      \}\n      // Last stretch up to the surface.\n      float3 p = origin + dir * (0.5f * (tPrev + dist));\n      float3 stepT = exp3(-density(p, origin.y) * (dist - tPrev));\n      inscatter += transmittance * (float3(1.0f) - stepT) * light;\n      transmittance *= stepT;\n    \}\n\n    float3 rgb = float3(src.x, src.y, src.z) * transmittance + inscatter;\n    float alpha = src.w;\n    if (output == 1) \{\n      rgb = transmittance;\n      alpha = 1.0f;\n    \} else if (output == 2) \{\n      rgb = inscatter;\n      alpha = 1.0f;\n    \}\n    dst() = float4(rgb.x, rgb.y, rgb.z, alpha);\n  \}\n\};\n"
  rebuild ""
  EzDepthHaze_output {{1}}
  EzDepthHaze_latlong_plate {{parent.plate_type}}
  EzDepthHaze_cam_row0 {{"\[exists parent.input1] ? parent.input1.world_matrix.0 : 1"} {"\[exists parent.input1] ? parent.input1.world_matrix.1 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.2 : 0"}}
  EzDepthHaze_cam_row1 {{"\[exists parent.input1] ? parent.input1.world_matrix.4 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.5 : 1"} {"\[exists parent.input1] ? parent.input1.world_matrix.6 : 0"}}
  EzDepthHaze_cam_row2 {{"\[exists parent.input1] ? parent.input1.world_matrix.8 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.9 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.10 : 1"}}
  EzDepthHaze_cam_position {{"\[exists parent.input1] ? parent.input1.world_matrix.3 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.7 : 0"} {"\[exists parent.input1] ? parent.input1.world_matrix.11 : 0"}}
  EzDepthHaze_focal {{"\[exists parent.input1] ? parent.input1.focal : 35"}}
  EzDepthHaze_haperture {{"\[exists parent.input1] ? parent.input1.haperture : 36"}}
  EzDepthHaze_vaperture {{"\[exists parent.input1] ? parent.input1.vaperture : 20.25"}}
  EzDepthHaze_latlong_camera_height {{parent.latlong_camera_height}}
  EzDepthHaze_depth_type {{parent.depth_type}}
  EzDepthHaze_depth_scale {{parent.depth_scale}}
  EzDepthHaze_sky_threshold {{parent.sky_threshold}}
  EzDepthHaze_haze_sky {{parent.sky_handling}}
  EzDepthHaze_sky_distance {{"parent.sky_distance * 1000"}}
  EzDepthHaze_use_env {{"\[exists parent.input2] && parent.haze_color_from==0"}}
  EzDepthHaze_env_rotation {{"parent.inherit_atmos && \[exists parent.input2.hdri_rotation] ? parent.input2.hdri_rotation : parent.env_rotation"}}
  EzDepthHaze_haze_color {{parent.haze_color.r} {parent.haze_color.g} {parent.haze_color.b}}
  EzDepthHaze_haze_color_gain {{parent.haze_color_gain}}
  EzDepthHaze_haze_density {{"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.r : parent.haze_density.r"} {"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.g : parent.haze_density.g"} {"parent.inherit_atmos && \[exists parent.input2.haze_density] ? parent.input2.haze_density.b : parent.haze_density.b"}}
  EzDepthHaze_haze_amount {{parent.haze_amount}}
  EzDepthHaze_haze_height {{"(parent.inherit_atmos && \[exists parent.input2.haze_height] ? parent.input2.haze_height : parent.haze_height) * 1000"}}
  EzDepthHaze_haze_start {{parent.haze_start}}
  EzDepthHaze_max_distance {{"parent.max_distance * 1000"}}
  EzDepthHaze_volumetric {{parent.haze_mode}}
