shaped(t.z), s.w);\n    else\n      dst() = float4(s.x * scale(t.x), s.y * scale(t.y), s.z * scale(t.z), s.w);\n  \}\n\};\n"
  rebuild ""
  EzDepthHazeShape_curve {{"1 + 1.5 * parent.silhouette"}}
  EzDepthHazeShape_mode {{0}}
  EzDepthHazeShape_sky_threshold {{parent.sky_threshold}}
  rebuild_finalise ""
  name Silhouette_transmittance
  xpos 60
  ypos -20
